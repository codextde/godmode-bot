{
  "name": "@godmode/website",
  "private": true,
  "version": "0.2.48",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "cp ../../scripts/install.sh public/install.sh && cp ../../scripts/runner.sh public/runner.sh && astro build",
    "preview": "pnpm build && wrangler dev",
    "typecheck": "astro check",
    "test": "bun test test",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply godmode-site --remote",
    "db:migrate:local": "wrangler d1 migrations apply godmode-site --local",
    "stripe:setup": "node scripts/stripe-setup.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@godmode/shared": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261106.1",
    "lucide-static": "^1.69.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
