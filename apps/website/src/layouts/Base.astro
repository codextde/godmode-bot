---
import '@/styles/global.css';
import { SITE, PRICING, TRACKING } from '@/config/site';
import Consent from '@/components/Consent.astro';
import { LOCALES, basePath, cleanPath, counterpart, isTranslated, langOf } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  bare?: boolean;
}

const lang = langOf(Astro.url);
const { title, description = SITE.description[lang], image = '/media/og-image.png', noindex = false, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.title[lang];
const siteUrl = Astro.site ?? SITE.url;
const canonical = new URL(cleanPath(Astro.url.pathname), siteUrl).href;
const translated = !bare && isTranslated(Astro.url.pathname);
const alternates = translated
  ? [
      { hreflang: 'en', href: new URL(counterpart(Astro.url.pathname, 'en'), siteUrl).href },
      { hreflang: 'de', href: new URL(counterpart(Astro.url.pathname, 'de'), siteUrl).href },
      { hreflang: 'x-default', href: new URL(basePath(Astro.url.pathname), siteUrl).href },
    ]
  : [];
// First visit from a German browser on an English page that has a German version: switch once. The language
// switcher stores the choice in gm_lang, so nobody is sent back and forth.
const autoDe = translated && lang === 'en' ? counterpart(Astro.url.pathname, 'de') : '';
const ogImage = new URL(image, Astro.site ?? SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: SITE.product,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'macOS',
  description: SITE.description[lang],
  inLanguage: lang,
  url: Astro.site?.href ?? SITE.url,
  publisher: { '@type': 'Organization', name: 'Codext GmbH', url: 'https://codext.de' },
  offers: [
    ...(['monthly', 'yearly'] as const).map((plan) => ({
      '@type': 'Offer',
      name: `Godmode ${PRICING.plans[plan].name}`,
      price: PRICING.plans[plan].price,
      priceCurrency: PRICING.currency,
      priceSpecification: {
        '@type': 'UnitPriceSpecification',
        price: PRICING.plans[plan].price,
        priceCurrency: PRICING.currency,
        billingDuration: plan === 'yearly' ? 'P1Y' : 'P1M',
      },
    })),
  ],
};

// Internal pages (admin) never load marketing pixels.
// Pages whose URL carries a license key never load the pixel either (uwt.js reads location.href).
const tracking =
  bare || Astro.url.searchParams.has('key') ? { x: '', xEvents: {} } : { x: TRACKING.xPixelId, xEvents: TRACKING.xEvents };
---

<!doctype html>
<html lang={lang} data-theme={bare ? 'dark' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={bare ? '#0a0a09' : '#faf7f2'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.product} />
    <meta property="og:locale" content={LOCALES[lang]} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      autoDe && (
        <script is:inline define:vars={{ autoDe }}>
          try {
            var chosen = /(?:^|; )gm_lang=/.test(document.cookie);
            var ref = document.referrer && new URL(document.referrer).host === location.host;
            var de = /^de\b/i.test((navigator.languages && navigator.languages[0]) || navigator.language || '');
            if (!chosen && !ref && de && !/[?&]lang=en\b/.test(location.search)) location.replace(autoDe + location.search + location.hash);
          } catch (e) {}
        </script>
      )
    }
    <script is:inline>
      document.documentElement.classList.add('js');
      // If the main script never runs, don't leave reveal-on-scroll content invisible.
      setTimeout(function () {
        if (!window.__gm) document.documentElement.classList.remove('js');
      }, 2500);
    </script>
    <script is:inline define:vars={{ tracking }}>
      window.__gmTracking = tracking;
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {
      TRACKING.cfBeacon && (
        <script
          defer
          is:inline
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: TRACKING.cfBeacon })}
        />
      )
    }
    <slot name="head" />
  </head>
  <body class="min-h-dvh">
    <slot />
    {!bare && <Consent />}
    <script>
      import '@/scripts/main';
    </script>
  </body>
</html>
