    ideasHint: 'Klicken zum Kopieren, dann in Godmode einfügen.',
    ideas: [
      'Räum mein Postfach auf und schreib Antwortentwürfe an alle, die auf mich warten',
      'Lade die Rechnungen dieses Monats aus meinen Lieferantenportalen herunter',
      'Trag die Werbezahlen dieser Woche aus Meta und Google in unsere Report-Tabelle ein',
      'Such 20 Firmen wie unsere in meiner Gegend und trag sie in eine Tabelle ein',
      'Prüf die Preise meiner drei Konkurrenten und sag mir, was sich geändert hat',
      'Plane die Instagram-Posts für nächste Woche und zeig mir den Plan vorher',
    ],
    after: `Nach ${freeDays} Tagen fragt Godmode, ob du es behalten willst: $${monthly.price} im Monat oder $${yearly.perMonth} im Monat bei jährlicher Zahlung. Bis dahin brauchst du keine Karte. Godmode denkt mit Claude, deshalb meldest du dich bei der Einrichtung mit deinem Claude-Pro- oder Max-Abo an.`,
    pricing: 'Preise und FAQ ansehen',
    advanced: 'Für Fortgeschrittene: Dauerbetrieb auf einem freien Mac',
    advancedBody: 'Für einen Mac, der immer an bleibt und den du aus jedem Browser oder vom Handy aus erreichst. Füg das im Terminal auf diesem Mac ein. Unsicher?',
    emailUs: 'Schreib uns',
    emailUsSubject: 'Godmode im Dauerbetrieb',
    help: ', wir helfen dir.',
    serverFile: 'Oder die Server-Datei:',
    appleChip: 'Apple-Chip',
  },
}[lang];

const servers = [
  { id: 'server-macos-arm64', label: t.appleChip },
  { id: 'server-macos-x64', label: 'Intel' },
];
const handoff = `mailto:?subject=${encodeURIComponent(t.handoffSubject)}&body=${encodeURIComponent(t.handoffBody)}`;
---

<Base title={t.title} description={t.description}>
  <Nav home={false} />
  <main class="relative pt-32 pb-24 sm:pt-40">
    <div class="hero-wash pointer-events-none absolute inset-x-0 top-0 -z-10 h-[700px]" aria-hidden="true"></div>
    <div class="container-x max-w-[880px] text-center">
      <Character size={84} mood="happy" seed="download" class="mx-auto block" />
      <h1 class="h-section mx-auto mt-6 max-w-[14ch]">{t.h1} <span class="serif">{t.h1Accent}</span></h1>
      <p class="lead mx-auto mt-5 max-w-[520px] !text-text-2">{t.lead}</p>

      {
        phone ? (
          <div class="card mx-auto mt-10 max-w-[560px] p-6 text-left sm:p-8">
            <div class="flex items-start gap-4">
              <span class="grid size-12 flex-none place-items-center rounded-2xl bg-brand-soft text-brand">
                <Icon name="laptop" size={22} />
              </span>
              <div>
                <p class="h-card">{t.sendTitle}</p>
                <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{t.sendBody}</p>
              </div>
            </div>
            <div class="mt-6 flex flex-col gap-2 sm:flex-row">
              <a href={handoff} class="btn btn-primary btn-lg sm:flex-1" data-track="download_handoff_email">
                <Icon name="mail" size={17} /> {t.emailLink}
              </a>
              <button type="button" class="btn btn-ghost btn-lg sm:flex-1" data-copy={pageUrl} data-track="download_handoff_copy">
                <Icon name="link" size={16} /> <span data-copy-label>{t.copyLink}</span>
              </button>
            </div>
          </div>
        ) : (
          <div class="mt-10">
            {notMac && (
              <div class="card mx-auto mb-8 max-w-[600px] p-6 text-left sm:p-7">
                <p class="h-card flex items-center gap-2.5">
                  <Icon name="monitor" size={19} class="text-brand" /> {t.notMacTitle}
                </p>
                <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.notMacBody}</p>
                <WaitlistForm source="windows" class="mt-5" />
              </div>
            )}
            <a
              href={`/download/${primary}`}
              class="btn btn-primary btn-xl"
              data-dl-main
              data-track={`download_${primary}`}
              data-intel-label={t.dlIntel}
              data-intel-chip={t.chipIntel}
              data-apple-other={t.otherApple}
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.42-3.65zM14.1 5.85c.63-.77 1.06-1.83.94-2.9-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.76-.96 2.8 1.01.08 2.05-.52 2.68-1.27z" /></svg>
              <span data-dl-label>{intel ? t.dlIntel : t.dlApple}</span>
              <Icon name="arrow-down" size={19} class="opacity-80" />
            </a>
            <p class="mt-4 text-[14px] text-muted">
              <span data-dl-chip>{intel ? t.chipIntel : t.chipApple}</span>
              <a href={`/download/${other}`} class="ml-1 font-medium text-text underline decoration-line-3 underline-offset-2 hover:decoration-brand" data-dl-other data-track={`download_${other}`}>
                {intel ? t.otherApple : t.otherIntel}
              </a>
            </p>
            <p class="mx-auto mt-6 hidden max-w-[460px] items-center justify-center gap-2 rounded-full bg-brand-soft px-4 py-2.5 text-[14.5px] font-medium text-brand" data-dl-started role="status">
              <Icon name="circle-check" size={17} /> {t.started}
            </p>
          </div>
        )
      }

      {
        key && (
          <div class="card mx-auto mt-10 max-w-[640px] p-6 text-left sm:p-8">
            <p class="text-[13px] font-semibold text-muted">{t.keyLabel}</p>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
              <code class="flex-1 rounded-xl bg-surface-2 px-4 py-3.5 font-mono text-[16px] tracking-[0.04em] break-all text-text ring-1 ring-line-2 sm:text-[18px] sm:tracking-[0.06em]">
                {key}
              </code>
              <button type="button" class="btn btn-ghost" data-copy={key}>
                <Icon name="copy" size={15} /> <span data-copy-label>{t.copy}</span>
              </button>
            </div>
            <p class="mt-3 text-[14px] text-muted">{t.keyHint}</p>
          </div>
        )
      }
    </div>

    <section class="container-x mt-20 max-w-[1080px]" aria-labelledby="install-title">
      <h2 id="install-title" class="text-center text-[clamp(26px,3.2vw,36px)] font-semibold tracking-[-0.03em]">{t.stepsTitle}</h2>
      <ol class="mt-10 grid gap-4 md:grid-cols-3">
        <li class="card p-5 sm:p-6">
          <div class="dl-step-art" aria-hidden="true">
            <div class="flex flex-col items-center gap-2">
              <span class="dmg-icon"><Icon name="hard-drive-download" size={28} class="text-text-2" /></span>
              <span class="rounded-md bg-surface px-2 py-0.5 text-[12px] font-medium text-text-2 ring-1 ring-line">Godmode.dmg</span>
            </div>
          </div>
          <p class="mt-5 flex items-center gap-3"><span class="step-num !size-9 !text-[15px]">1</span><span class="h-card">{t.step1}</span></p>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.step1Body[0]}<b class="font-semibold text-text-2">Godmode</b>{t.step1Body[1]}</p>
        </li>
        <li class="card p-5 sm:p-6">
          <div class="dl-step-art" aria-hidden="true">
            <div class="flex items-center gap-4">
              <span class="flex flex-col items-center gap-1.5"><Logo size={52} /><span class="text-[11.5px] font-medium text-text-2">Godmode</span></span>
              <Icon name="arrow-right" size={22} class="drag-arrow text-brand" stroke={2.2} />
              <span class="flex flex-col items-center gap-1.5">
                <span class="grid size-[52px] place-items-center rounded-[14px] bg-[#cfe3f7] text-[#2a5d8f]"><Icon name="folder" size={26} /></span>
                <span class="text-[11.5px] font-medium text-text-2">{t.applications}</span>
              </span>
            </div>
          </div>
          <p class="mt-5 flex items-center gap-3"><span class="step-num !size-9 !text-[15px]">2</span><span class="h-card">{t.step2}</span></p>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.step2Body}</p>
        </li>
        <li class="card p-5 sm:p-6">
          <div class="dl-step-art" aria-hidden="true">
            <div class="w-[78%] space-y-2">
              <div class="rounded-2xl rounded-br-md bg-brand px-3 py-2 text-left text-[12.5px] leading-snug text-white">{t.step3Ask}</div>
              <div class="flex items-start gap-2 rounded-2xl rounded-bl-md bg-surface px-3 py-2 text-left text-[12.5px] leading-snug text-text ring-1 ring-line">
                <Character size={20} mood="working" seed="dl-step" /> {t.step3Reply}
              </div>
            </div>
          </div>
          <p class="mt-5 flex items-center gap-3"><span class="step-num !size-9 !text-[15px]">3</span><span class="h-card">{t.step3}</span></p>
          <p class="mt-2 text-[15px] leading-relaxed text-muted">{t.step3Body}</p>
        </li>
      </ol>

      <div class="mt-14 text-center">
        <h3 class="text-[19px] font-semibold tracking-[-0.02em]">{t.ideasTitle}</h3>
        <p class="mt-1.5 text-[14px] text-muted">{t.ideasHint}</p>
        <div class="mx-auto mt-6 flex max-w-[900px] flex-wrap justify-center gap-2.5">
          {
            t.ideas.map((idea, i) => (
              <button type="button" class="idea-chip" data-copy={idea} data-track={`download_idea_${i}`}>
                <Icon name="copy" size={14} class="text-dim" />
                <span data-copy-label>{idea}</span>
              </button>
            ))
          }
        </div>
      </div>

      <div class="card-soft mx-auto mt-14 max-w-[720px] p-6 text-center sm:p-8">
        <p class="text-[15.5px] leading-relaxed text-text-2">{t.after}</p>
        <a href={href(lang, '/#pricing')} class="mt-3 inline-flex text-[14.5px] font-medium text-brand underline decoration-[var(--brand-line)] underline-offset-4">{t.pricing}</a>
      </div>

      <details class="faq group mx-auto mt-10 max-w-[720px] rounded-2xl ring-1 ring-line">
        <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-[14.5px] font-medium text-muted hover:text-text">
          {t.advanced}
          <span class="plus grid size-7 flex-none place-items-center rounded-full ring-1 ring-line-2" aria-hidden="true">
            <svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
          </span>
        </summary>
        <div class="px-5 pb-5 text-left">
          <p class="text-[14px] leading-relaxed text-muted">
            {t.advancedBody}
            <a href={`mailto:${SITE.email}?subject=${encodeURIComponent(t.emailUsSubject)}`} class="text-text underline decoration-line-3 underline-offset-2">{t.emailUs}</a>{t.help}
          </p>
          <div class="mt-4 flex flex-col gap-2 sm:flex-row sm:items-center">
            <code class="min-w-0 flex-1 overflow-x-auto rounded-xl bg-surface-2 px-4 py-3 font-mono text-[13px] whitespace-nowrap text-text-2 ring-1 ring-line-2">{install}</code>
            <button type="button" class="btn btn-ghost btn-sm" data-copy={install} data-track="download_install_copy">
              <Icon name="copy" size={14} /> <span data-copy-label>{t.copy}</span>
            </button>
          </div>
          <p class="mt-3 text-[13px] text-dim">
            {t.serverFile}
            {
              servers.map((s, i) => (
                <>
                  {i > 0 && ' · '}
                  <a class="underline decoration-line-3 underline-offset-2 hover:text-text" href={`/download/${s.id}`} data-track={`download_${s.id}`}>
                    {s.label}
                  </a>
                </>
              ))
            }
          </p>
        </div>
      </details>
    </section>
  </main>
  <Footer />
</Base>

<script>
  import { track, xEvent } from '@/scripts/analytics';
  // Apple silicon or Intel? Browsers report both as "Intel Mac", but Chrome and Firefox name the graphics chip.
  // Safari hides it, so Apple silicon stays the default there.
  const main = document.querySelector<HTMLAnchorElement>('[data-dl-main]');
  const otherLink = document.querySelector<HTMLAnchorElement>('[data-dl-other]');
  const chip = document.querySelector<HTMLElement>('[data-dl-chip]');
  const label = document.querySelector<HTMLElement>('[data-dl-label]');
  const params = new URLSearchParams(location.search);
  let target = main?.getAttribute('href') ?? '/download/mac';
  if (main && !params.has('platform') && /Macintosh/.test(navigator.userAgent)) {
    try {
      const gl = document.createElement('canvas').getContext('webgl');
      const ext = gl?.getExtension('WEBGL_debug_renderer_info');
      const gpu = gl && ext ? String(gl.getParameter(ext.UNMASKED_RENDERER_WEBGL)) : '';
      if (/Intel|AMD|Radeon|NVIDIA/i.test(gpu) && !/Apple/i.test(gpu)) {
        target = '/download/mac-intel';
        main.href = target;
        main.dataset.track = 'download_mac-intel';
        if (label) label.textContent = main.dataset.intelLabel ?? '';
        if (chip) chip.textContent = main.dataset.intelChip ?? '';
        if (otherLink) {
          otherLink.href = '/download/mac';
          otherLink.dataset.track = 'download_mac';
          otherLink.textContent = main.dataset.appleOther ?? '';
        }
      }
    } catch {
      /* keep the default */
    }
  }
  if (main && params.get('start') === '1' && /Macintosh/.test(navigator.userAgent)) {
    params.delete('start');
    history.replaceState(null, '', params.size ? `?${params}` : location.pathname);
    document.querySelector<HTMLElement>('[data-dl-started]')?.style.setProperty('display', 'flex');
    track('click', main.dataset.track);
    xEvent('download', { content_type: 'mac_app' });
    setTimeout(() => (location.href = target), 400);
  }
</script>
