---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import Character from '@/components/ui/Character.astro';
import WaitlistForm from '@/components/ui/WaitlistForm.astro';
import { PRICING, SITE } from '@/config/site';
import { href, langOf } from '@/i18n';
import type { DownloadProps } from './download-request';

type Props = DownloadProps;
const { key, phone, notMac, intel } = Astro.props;
const lang = langOf(Astro.url);
const primary = intel ? 'mac-intel' : 'mac';
const other = intel ? 'mac' : 'mac-intel';

const { freeDays } = PRICING;
const { monthly, yearly } = PRICING.plans;
const install = `curl -fsSL ${SITE.url}/install.sh | sh`;
const pageUrl = `${SITE.url}${href(lang, '/download')}`;

const t = {
  en: {
    title: 'Download for Mac',
    description: `Download Godmode for Mac (Apple chip or Intel). Free for ${freeDays} days. No card, no sign-up.`,
    h1: 'Download Godmode',
    h1Accent: 'for Mac',
    lead: `Free for ${freeDays} days. No card, no sign-up. Just download and tell it your first task.`,
    handoffSubject: 'Download Godmode',
    handoffBody: `Godmode for Mac, free for ${freeDays} days:\n${pageUrl}\n`,
    sendTitle: 'Send it to your Mac',
    sendBody: 'Godmode runs on your Mac. Send yourself the link and open it there.',
    emailLink: 'Email me the link',
    copyLink: 'Copy link',
    notMacTitle: 'Not on a Mac? Windows is coming.',
    notMacBody:
      'Godmode is for Mac for now. Leave your email and we’ll tell you the day the Windows version is ready. Or download it below on a Mac.',
    dlApple: 'Download for Mac',
    dlIntel: 'Download for Mac with Intel',
    chipApple: 'For Macs with an Apple chip (M1 or newer).',
    chipIntel: 'For Macs with an Intel chip.',
    otherApple: 'Mac with Apple chip?',
    otherIntel: 'Mac with Intel chip?',
    started: 'Your download is starting. Follow the steps below.',
    keyLabel: 'Your licence key',
    copy: 'Copy',
    keyHint: 'Paste it into Godmode during setup, or later in Settings → License.',
    stepsTitle: 'Up and running in three steps',
    applications: 'Applications',
    step1: 'Open the downloaded file',
    step1Body: ['Find ', ' in your Downloads folder (or at the bottom of your browser) and double-click it.'],
    step2: 'Drag Godmode into Applications',
    step2Body: 'A window opens. Drag the Godmode icon onto the Applications folder. That’s the whole install.',
    step3Ask: 'Download my invoices and file them in Dropbox',
    step3Reply: 'On it. Signing in to 6 portals…',
    step3: 'Open it and give it a task',
    step3Body: 'Open Godmode from Applications. Setup takes a few minutes, then tell it your first task in plain words.',
    ideasTitle: 'Not sure what to ask first? Try one of these',
    ideasHint: 'Click to copy, then paste it into Godmode.',
    ideas: [
      'Sort my inbox and draft replies to everyone waiting on me',
      'Download this month’s invoices from my supplier portals',
      'Put this week’s ad numbers from Meta and Google into our report sheet',
      'Find 20 companies like ours in my area and put them in a sheet',
      'Check my three competitors’ prices and tell me what changed',
      'Plan next week’s Instagram posts and show me the plan first',
    ],
    after: `After ${freeDays} days, Godmode asks if you want to keep it: $${monthly.price} a month, or $${yearly.perMonth} a month billed yearly. No card until then. Godmode thinks with Claude, so you sign in with your Claude Pro or Max plan during setup.`,
    pricing: 'See pricing and FAQ',
    advanced: 'Advanced: always-on version for a spare Mac',
    advancedBody: 'For a Mac that stays on, reached from any browser or your phone. Paste this into Terminal on that Mac. Not sure?',
    emailUs: 'Email us',
    emailUsSubject: 'Always-on Godmode',
    help: ' and we’ll help.',
    serverFile: 'Or the server file:',
    appleChip: 'Apple chip',
  },
  de: {
    title: 'Für Mac herunterladen',
    description: `Lade Godmode für deinen Mac herunter (Apple-Chip oder Intel). ${freeDays} Tage kostenlos. Ohne Karte, ohne Anmeldung.`,
    h1: 'Godmode herunterladen',
    h1Accent: 'für Mac',
    lead: `${freeDays} Tage kostenlos. Ohne Karte, ohne Anmeldung. Einfach herunterladen und die erste Aufgabe geben.`,
    handoffSubject: 'Godmode herunterladen',
    handoffBody: `Godmode für Mac, ${freeDays} Tage kostenlos:\n${pageUrl}\n`,
    sendTitle: 'Schick es an deinen Mac',
    sendBody: 'Godmode läuft auf deinem Mac. Schick dir den Link und öffne ihn dort.',
    emailLink: 'Link per E-Mail schicken',
    copyLink: 'Link kopieren',
    notMacTitle: 'Kein Mac? Windows kommt.',
    notMacBody:
      'Godmode gibt es vorerst nur für Mac. Hinterlass deine E-Mail, dann sagen wir dir Bescheid, sobald die Windows-Version fertig ist. Oder lade es unten auf einem Mac herunter.',
    dlApple: 'Für Mac herunterladen',
    dlIntel: 'Für Mac mit Intel herunterladen',
    chipApple: 'Für Macs mit Apple-Chip (M1 oder neuer).',
    chipIntel: 'Für Macs mit Intel-Chip.',
    otherApple: 'Mac mit Apple-Chip?',
    otherIntel: 'Mac mit Intel-Chip?',
    started: 'Dein Download startet. Folge den Schritten unten.',
    keyLabel: 'Dein Lizenzschlüssel',
    copy: 'Kopieren',
    keyHint: 'Füge ihn bei der Einrichtung in Godmode ein oder später unter Einstellungen → Lizenz.',
