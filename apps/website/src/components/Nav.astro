---
import Logo from './ui/Logo.astro';
import Icon from './ui/Icon.astro';
import DownloadButton from './ui/DownloadButton.astro';
import { PRICING } from '@/config/site';

interface Props {
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? '' : '/';
const links = [
  { href: '#jobs', label: 'What it does' },
  { href: '#how', label: 'How it works' },
  { href: '#trust', label: 'Safety' },
  { href: '#pricing', label: 'Pricing' },
  { href: '#faq', label: 'FAQ' },
];
---

<header data-nav class="nav fixed inset-x-0 top-0 z-50">
  <div class="container-x flex h-[68px] items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-2.5" aria-label="Godmode home">
      <Logo size={30} class="transition-transform duration-500 ease-[var(--ease-spring)] group-hover:rotate-[-8deg]" />
      <span class="text-[17px] font-semibold tracking-[-0.03em]">Godmode</span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        links.map((l) => (
          <a href={base + l.href} data-nav-link class="nav-link">
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/use-cases" class="nav-link hidden md:inline-flex lg:hidden xl:inline-flex" data-track="nav_use_cases">Examples</a>
      <DownloadButton source="nav" label="Download free" size="sm" class="hidden sm:inline-flex" />
      <button
        type="button"
        class="btn btn-ghost btn-sm !px-2.5 lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu"
      >
        <span class="menu-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu class="mobile-menu lg:hidden">
    <nav class="container-x flex flex-col py-4" aria-label="Mobile">
      {
        [...links, { href: '/use-cases', label: 'Examples' }].map((l, i) => (
          <a
            href={l.href.startsWith('/') ? l.href : base + l.href}
            class="flex items-center justify-between border-b border-line py-4 text-[22px] font-semibold tracking-tight"
            style={`--i:${i}`}
          >
            {l.label}
            <Icon name="arrow-up-right" size={18} class="text-dim" />
          </a>
        ))
      }
      <div class="mt-6 grid gap-2">
        <DownloadButton source="menu" label="Download free" size="lg" full />
        <p class="mt-1 text-center text-[13.5px] text-muted">Free for {PRICING.freeDays} days · No card · No sign-up</p>
      </div>
    </nav>
  </div>
</header>
