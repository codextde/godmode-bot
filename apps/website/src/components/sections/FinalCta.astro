---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import CheckoutButton from '../ui/CheckoutButton.astro';
import { PRICING } from '@/config/site';
---

<section class="relative overflow-hidden py-24 sm:py-32">
  <div class="final-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="container-x text-center">
    <div class="mx-auto grid size-20 place-items-center" data-reveal="scale">
      <div class="final-logo relative">
        <Logo size={76} />
      </div>
    </div>
    <Words text="Stop doing work *a computer can do.*" class="h-display text-grad mx-auto mt-10 max-w-[13ch] !text-[clamp(42px,7vw,96px)]" />
    <p class="lead mx-auto mt-7 max-w-[560px]" data-reveal style="--d:300">
      Hand it the busywork today. Tomorrow morning, it’s done — and your agent knows how you like it.
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal style="--d:450">
      <CheckoutButton plan="lifetime" label={`Get lifetime — $${PRICING.plans.lifetime.price}`} source="final" size="lg" />
      <CheckoutButton plan="monthly" label={`Start at $${PRICING.plans.monthly.price}/month`} source="final" variant="ghost" size="lg" />
    </div>
    <p class="mt-6 flex items-center justify-center gap-2 text-[13px] text-muted" data-reveal style="--d:550">
      <Icon name="shield-check" size={14} class="text-brand" />
      {PRICING.guaranteeDays}-day money-back guarantee · secure checkout with Stripe
    </p>
  </div>
</section>
