---
import Words from '../ui/Words.astro';
import Character from '../ui/Character.astro';
import DownloadButton from '../ui/DownloadButton.astro';
import Icon from '../ui/Icon.astro';
import { PRICING } from '@/config/site';
---

<section class="relative pt-4 pb-16 sm:pb-24">
  <div class="container-x">
    <div class="final-panel px-6 py-16 text-center sm:px-12 sm:py-24">
      <div class="face-row relative mx-auto w-fit" data-reveal="scale" aria-hidden="true">
        <Character character={{ body: 'drop', eyes: 'happy', mouth: 'grin', top: 'sprout', face: 'blush', neck: 'none' }} color="orange" size={54} seed="cta-1" follow />
        <Character character={{ body: 'gumdrop', eyes: 'dots', mouth: 'smile', top: 'none', face: 'glasses', neck: 'bowtie' }} color="amber" size={64} seed="cta-2" follow />
        <Character size={96} seed="cta-3" follow class="relative z-[1] mx-1" />
        <Character character={{ body: 'kitty', eyes: 'dots', mouth: 'cat', top: 'none', face: 'shades', neck: 'none' }} color="rose" size={64} seed="cta-4" follow />
        <Character character={{ body: 'ghost', eyes: 'wide', mouth: 'smile', top: 'antenna', face: 'none', neck: 'scarf' }} color="sky" size={54} seed="cta-5" follow />
      </div>
      <Words text="Stop doing work *a computer can do.*" class="h-display mx-auto mt-8 max-w-[13ch] !text-[clamp(40px,6.4vw,84px)]" />
      <p class="lead mx-auto mt-6 max-w-[520px]" data-reveal style="--d:300">
        Give Godmode your most boring task this week. If it doesn’t save you time, you’ve lost nothing.
      </p>
      <div class="mt-10 flex justify-center" data-reveal style="--d:450">
        <DownloadButton source="final" size="xl" />
      </div>
      <p class="hero-note mt-5" data-reveal style="--d:520">
        <span><Icon name="check" size={15} class="text-brand" stroke={2.4} /> Free for {PRICING.freeDays} days</span>
        <span aria-hidden="true" class="text-line-3">·</span>
        <span><Icon name="check" size={15} class="text-brand" stroke={2.4} /> No card</span>
        <span aria-hidden="true" class="text-line-3">·</span>
        <span><Icon name="check" size={15} class="text-brand" stroke={2.4} /> No sign-up</span>
      </p>
    </div>
  </div>
</section>
