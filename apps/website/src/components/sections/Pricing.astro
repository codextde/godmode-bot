---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import DownloadButton from '../ui/DownloadButton.astro';
import { eur, PRICING, SETUP, setupPrice, type Plan } from '@/config/site';
import { href, langOf } from '@/i18n';

const lang = langOf(Astro.url);
const t = {
  en: {
    eyebrow: 'Pricing',
    h: 'Try it first. *Pay only if it helps.*',
    lead: `Download Godmode and use everything free for ${PRICING.freeDays} days. No card, no sign-up. If it saves you time, keep it. If not, just stop using it.`,
    plans: {
      private: { name: 'Private', for: 'For personal use.' },
      company: { name: 'Company', for: 'For your whole company, on all your Macs.' },
    },
    then: `Free for ${PRICING.freeDays} days, then`,
    perMonth: '/ month',
    billed: 'Billed monthly. Cancel anytime.',
    includedH: 'Both plans include',
    included: [
      'Unlimited AI coworkers, tasks and automations',
      'Works in your browser and apps, signed in as you',
      'Runs on a schedule or when an email arrives',
      'Password vault with 2FA codes',
      'Message it from your phone, Slack or Telegram',
      'Every update while you’re subscribed',
    ],
    download: 'Download free',
    subscribe: 'Already sure? Subscribe now',
    setupName: 'Done-for-you setup',
    setupOnce: 'one-time, plus VAT',
    setupText: 'We set Godmode up with you and build your first automations, so it saves you hours from week one.',
    setupCta: 'See what’s included',
    guarantee: `${PRICING.guaranteeDays}-day money-back guarantee on your first payment`,
    claude: 'Works with your Claude Pro or Max plan',
    what: 'What’s that?',
    invoice: 'Company invoices with VAT ID',
  },
  de: {
    eyebrow: 'Preise',
    h: 'Erst testen. *Nur zahlen, wenn es hilft.*',
    lead: `Lade Godmode herunter und nutze alles ${PRICING.freeDays} Tage kostenlos. Ohne Karte, ohne Anmeldung. Spart es dir Zeit, behalte es. Wenn nicht, hör einfach auf.`,
    plans: {
      private: { name: 'Privat', for: 'Für private Nutzung.' },
      company: { name: 'Firma', for: 'Für deine ganze Firma, auf allen Macs.' },
    },
    then: `${PRICING.freeDays} Tage kostenlos, danach`,
    perMonth: '/ Monat',
    billed: 'Monatliche Zahlung. Jederzeit kündbar.',
    includedH: 'In beiden Tarifen',
    included: [
      'Unbegrenzt viele KI-Kollegen, Aufgaben und Automationen',
      'Arbeitet in deinem Browser und deinen Programmen, angemeldet als du',
      'Läuft nach Zeitplan oder wenn eine E-Mail kommt',
      'Passwort-Tresor mit 2FA-Codes',
      'Schreib ihm vom Handy, aus Slack oder Telegram',
      'Alle Updates, solange du dabei bist',
    ],
    download: 'Kostenlos laden',
    subscribe: 'Schon überzeugt? Jetzt abonnieren',
    setupName: 'Einrichtung vom Profi',
    setupOnce: 'einmalig, zzgl. MwSt.',
    setupText: 'Wir richten Godmode mit dir ein und bauen deine ersten Automationen, damit es dir ab der ersten Woche Stunden spart.',
    setupCta: 'Alle Leistungen ansehen',
    guarantee: `${PRICING.guaranteeDays} Tage Geld-zurück-Garantie auf die erste Zahlung`,
    claude: 'Läuft mit deinem Claude Pro- oder Max-Abo',
    what: 'Was ist das?',
    invoice: 'Firmenrechnung mit USt-IdNr.',
  },
}[lang];
const plans: Plan[] = ['private', 'company'];
---

<section id="pricing" class="relative py-16 sm:py-24" data-track-view="pricing">
  <div class="container-x">
    <div class="mx-auto max-w-[720px] text-center">
      <p class="eyebrow justify-center" data-reveal>{t.eyebrow}</p>
      <Words text={t.h} class="h-section mx-auto mt-4" />
      <p class="lead mx-auto mt-5 max-w-[560px]" data-reveal style="--d:200">{t.lead}</p>
    </div>

    <div class="mx-auto mt-12 grid max-w-[980px] gap-4 md:grid-cols-2">
      {
        plans.map((plan, i) => (
          <form method="post" action="/api/checkout" data-checkout={`pricing_${plan}`} class="price-card flex flex-col p-7 sm:p-10" data-reveal style={`--d:${i * 100}`}>
            <input type="hidden" name="plan" value={plan} />
            <input type="hidden" name="trial" value="0" />
            <p class="text-[17px] font-semibold">{t.plans[plan].name}</p>
            <p class="mt-1 text-[15px] text-muted">{t.plans[plan].for}</p>

            <p class="mt-7 text-[16px] font-medium text-brand">{t.then}</p>
            <p class="mt-2 flex items-baseline gap-2">
              <span class="price-num">{eur(PRICING.plans[plan].price, lang)}</span>
              <span class="text-[16px] text-muted">{t.perMonth}</span>
            </p>
            <p class="mt-2 text-[14.5px] text-muted">{t.billed}</p>

            <div class="mt-8">
              <DownloadButton source={`pricing_${plan}`} label={t.download} size="lg" full />
              <p class="mt-4 text-center text-[14px]">
                <button type="submit" class="link-btn"><span class="btn-label">{t.subscribe}</span></button>
              </p>
            </div>
          </form>
        ))
      }
    </div>

    <div class="card mx-auto mt-4 max-w-[980px] p-7 sm:p-10" data-reveal style="--d:150">
      <p class="text-[17px] font-semibold">{t.includedH}</p>
      <ul class="mt-5 grid gap-x-8 gap-y-2.5 text-[15px] text-text-2 md:grid-cols-2">
        {
          t.included.map((f) => (
            <li class="flex items-start gap-2.5">
              <Icon name="check" size={17} stroke={2.4} class="mt-0.5 flex-none text-brand" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card mx-auto mt-4 flex max-w-[980px] flex-col gap-6 p-7 sm:p-10 md:flex-row md:items-center md:justify-between" data-reveal style="--d:200">
      <div class="max-w-[560px]">
        <p class="flex items-center gap-2 text-[17px] font-semibold">
          <Icon name="wrench" size={17} class="text-brand" /> {t.setupName}
        </p>
        <p class="mt-3 flex flex-wrap items-baseline gap-x-2">
          <span class="text-[34px] leading-tight font-semibold tracking-[-0.03em]">{setupPrice(lang)}</span>
          <span class="text-[14.5px] text-muted">{t.setupOnce}</span>
        </p>
        <p class="mt-3 text-[15px] leading-relaxed text-muted">{t.setupText}</p>
      </div>
      <a href={href(lang, '/setup')} class="btn btn-dark btn-lg group flex-none" data-track="pricing_setup">
        {t.setupCta} <Icon name="arrow-right" size={16} class="arrow" />
      </a>
    </div>

    <div class="mx-auto mt-6 flex max-w-[980px] flex-col gap-x-8 gap-y-3 text-[14px] text-muted sm:flex-row sm:flex-wrap sm:justify-center" data-reveal style="--d:150">
      <span class="flex items-center gap-2"><Icon name="shield-check" size={16} class="text-brand" /> {t.guarantee}</span>
      <span class="flex items-center gap-2">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" class="text-claude"><path fill="currentColor" d="M12 2l1.9 6.2L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.8z"></path></svg>
        {t.claude}
        <a href="#faq-claude" class="underline decoration-line-3 underline-offset-2 hover:text-text">{t.what}</a>
      </span>
      <span class="flex items-center gap-2"><Icon name="receipt" size={16} class="text-brand" /> {t.invoice}</span>
    </div>
  </div>
</section>
