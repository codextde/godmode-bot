---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import CheckoutButton from '../ui/CheckoutButton.astro';
import { PRICING, SITE, yearlySavings } from '@/config/site';

const { monthly, yearly, lifetime } = PRICING.plans;
const included = [
  'Unlimited agents, chats and automations',
  'Browser use with your Chrome sessions',
  'Background computer use',
  'Its own macOS VMs (Apple silicon)',
  'Encrypted vault, 2FA, password import',
  'Slack, Telegram, Teams & voice',
  'Desktop app + headless web dashboard',
  'macOS, Windows and Linux',
];
const proPerks = ['Every feature and every update', 'Cancel anytime in two clicks', 'Switch between monthly and yearly anytime'];
const lifetimePerks = ['Everything in Pro, for good', 'All future updates, included', 'Priority email support from the founder'];
const cycles = [
  { plan: 'monthly', label: 'Monthly', checked: false },
  { plan: 'yearly', label: 'Yearly', checked: true },
] as const;
---

<section id="pricing" class="relative py-20 sm:py-28" data-track-view="pricing">
  <div class="pricing-glow pointer-events-none absolute inset-x-0 top-40 -z-10 h-[700px]" aria-hidden="true"></div>
  <div class="container-x">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow justify-center" data-reveal><span class="n">10</span> Pricing</p>
      <Words text={`Free for ${PRICING.trialDays} days. *Then one simple price.*`} class="h-section mx-auto mt-6" />
      <p class="lead mx-auto mt-6 max-w-[560px]" data-reveal style="--d:200">
        Every feature in every plan. No seats, no credits, no caps.
      </p>
    </div>

    <div data-soldout-note hidden class="mx-auto mt-10 flex max-w-[980px] items-start gap-3 rounded-2xl p-4 text-[14px] ring-1 ring-[rgb(232_165_58/0.35)]" style="background: rgb(232 165 58 / 0.06)" role="status">
      <Icon name="hourglass" size={18} class="mt-0.5 flex-none text-warn" />
      <p class="text-text-2">
        <span class="text-text">Founder Lifetime just sold out.</span> Godmode Pro has every feature, and you can try it free for
        {PRICING.trialDays} days.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-[980px] gap-4 sm:mt-16 md:grid-cols-[1.18fr_1fr] md:items-stretch">
      <div class="price-card is-featured" data-reveal>
        <form method="post" action="/api/checkout" data-checkout="pricing" class="price-inner pro-card flex flex-col p-6 sm:p-10">
          <div class="flex items-center justify-between gap-3">
            <p class="text-[15px] font-medium">Godmode Pro</p>
            <span class="chip chip-brand"><Icon name="sparkles" size={11} /> {PRICING.trialDays} days free</span>
          </div>

          <fieldset class="seg mt-6">
            <legend class="sr-only">Billing period</legend>
            {
              cycles.map((c) => (
                <>
                  <input type="radio" name="plan" id={`cycle-${c.plan}`} value={c.plan} checked={c.checked} />
                  <label for={`cycle-${c.plan}`} data-track={`cycle_${c.plan}`}>
                    {c.label}
                    {c.plan === 'yearly' && <span class="seg-save">−{yearlySavings}%</span>}
                  </label>
                </>
              ))
            }
          </fieldset>

          <div class="price-swap mt-7" aria-live="polite">
            <div data-for="yearly">
              <p class="flex items-baseline gap-2">
                <span class="price-num">${yearly.perMonth}</span>
                <span class="text-[15px] text-muted">/ month</span>
                <s class="ml-1 text-[15px] text-dim" aria-label={`instead of $${monthly.price}`}>${monthly.price}</s>
              </p>
              <p class="mt-3 text-[14px] text-text-2">
                Billed ${yearly.price} yearly · <span class="text-brand">save {yearlySavings}%</span>
              </p>
            </div>
            <div data-for="monthly">
              <p class="flex items-baseline gap-2">
                <span class="price-num">${monthly.price}</span>
                <span class="text-[15px] text-muted">/ month</span>
              </p>
              <p class="mt-3 text-[14px] text-text-2">Billed monthly · cancel anytime</p>
            </div>
          </div>

          <button type="submit" class="btn btn-primary btn-lg group mt-7 w-full">
            <span class="btn-label">Start {PRICING.trialDays}-day free trial</span>
            <Icon name="arrow-right" size={16} class="arrow" />
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
          <p class="mt-3 text-center text-[13px] text-muted">No charge today. Cancel anytime before day {PRICING.trialDays}.</p>

          <div class="rule my-7"></div>
          <ul class="space-y-3 text-[14.5px]">
            {
              proPerks.map((f, i) => (
                <li class:list={['flex items-start gap-3', i ? 'text-text-2' : 'text-text']}>
                  <Icon name="check" size={16} stroke={2.2} class="mt-0.5 flex-none text-brand" />
                  {f}
                </li>
              ))
            }
          </ul>
        </form>
      </div>

      <div class="price-card" data-reveal style="--d:100" data-lifetime-card>
        <div class="price-inner flex flex-col p-6 sm:p-10">
          <div class="flex items-center justify-between gap-3">
            <p class="text-[15px] font-medium">{lifetime.name}</p>
            <span class="chip">One-time</span>
          </div>
          <div class="founder-slot mt-6" data-lifetime-slot>
            <i aria-hidden="true"></i>
            <span>First {PRICING.lifetimeCap} buyers only</span>
            <span class="founder-left" data-lifetime-left hidden></span>
          </div>
          <div class="mt-7">
            <p class="flex items-baseline gap-2">
              <span class="price-num">${lifetime.price}</span>
              <span class="text-[15px] text-muted">once</span>
            </p>
            <p class="mt-3 text-[14px] text-text-2">Pay once, own it. Every future update included.</p>
          </div>

          <CheckoutButton plan="lifetime" label="Get Founder Lifetime" source="pricing" variant="ghost" full size="lg" class="mt-7" />
          <p class="mt-3 text-center text-[13px] text-muted">{PRICING.guaranteeDays}-day money-back guarantee.</p>

          <div class="rule my-7"></div>
          <ul class="space-y-3 text-[14.5px]">
            {
              lifetimePerks.map((f, i) => (
                <li class:list={['flex items-start gap-3', i ? 'text-text-2' : 'text-text']}>
                  <Icon name="check" size={16} stroke={2.2} class="mt-0.5 flex-none text-muted" />
                  {f}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <div class="included mx-auto mt-4 max-w-[980px] rounded-[26px] p-6 ring-1 ring-line sm:p-8" data-reveal style="--d:120">
      <p class="text-[13px] text-muted">Included in every plan</p>
      <ul class="mt-5 grid gap-x-6 gap-y-3.5 text-[14.5px] sm:grid-cols-2 lg:grid-cols-4">
        {
          included.map((f) => (
            <li class="flex items-start gap-3 text-text-2">
              <Icon name="check" size={16} stroke={2.2} class="mt-0.5 flex-none text-brand" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mx-auto mt-3 grid max-w-[980px] gap-3 md:grid-cols-3" data-reveal style="--d:150">
      <div class="flex items-start gap-3 rounded-2xl p-4 ring-1 ring-line">
        <Icon name="shield-check" size={18} class="mt-0.5 flex-none text-brand" />
        <p class="text-[13px] leading-relaxed text-muted">
          <span class="text-text">Try first, then a {PRICING.guaranteeDays}-day guarantee.</span> Cancel during the trial and pay nothing.
          After your first payment, email us within {PRICING.guaranteeDays} days for a full refund.
        </p>
      </div>
      <div class="flex items-start gap-3 rounded-2xl p-4 ring-1 ring-line">
        <span class="mt-0.5 grid size-[18px] flex-none place-items-center text-claude">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l1.9 6.2L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.8z"></path></svg>
        </span>
        <p class="text-[13px] leading-relaxed text-muted">
          <span class="text-text">Runs on your Claude plan.</span> Sign in with Claude Pro or Max, or use an Anthropic API key — not
          included. <a href="#faq" class="underline decoration-line-3 underline-offset-2 hover:text-text">Details</a>
        </p>
      </div>
      <div class="flex items-start gap-3 rounded-2xl p-4 ring-1 ring-line">
        <Icon name="receipt-text" size={18} class="mt-0.5 flex-none text-muted" />
        <p class="text-[13px] leading-relaxed text-muted">
          <span class="text-text">Business-ready.</span> Invoice with your VAT ID, paid securely via Stripe. Card, Apple Pay, Google Pay
          & more.
        </p>
      </div>
    </div>

    <p class="mx-auto mt-8 max-w-[640px] text-center text-[13px] text-muted" data-reveal>
      <Icon name="hourglass" size={13} class="mr-1 inline -translate-y-px text-[#f0a488]" />
      {PRICING.founderNote}
    </p>
    <p class="mt-3 text-center text-[13px] text-dim" data-reveal>
      Need it for a team? <a href={`mailto:${SITE.email}?subject=Godmode%20for%20teams`} class="underline decoration-line-3 underline-offset-2 hover:text-text" data-track="teams_mail">Talk to us</a>.
    </p>
  </div>
</section>
