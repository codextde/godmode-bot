---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import CheckoutButton from '../ui/CheckoutButton.astro';
import { PRICING, SITE, yearlySavings } from '@/config/site';

const { monthly, yearly } = PRICING.plans;
const included = [
  'Unlimited agents, chats and automations',
  'Browser use with your Chrome sessions',
  'Background computer use',
  'Its own macOS VMs (Apple silicon)',
  'Encrypted vault, 2FA, password import',
  'Slack, Telegram, Teams & voice',
  'Desktop app + headless web dashboard',
  'macOS, Windows and Linux',
];
const cards = [
  {
    plan: 'yearly',
    name: 'Yearly',
    featured: true,
    chip: `Best value · save ${yearlySavings}%`,
    price: yearly.perMonth,
    was: monthly.price,
    billed: `Billed $${yearly.price} yearly`,
    perks: [`$${monthly.price * 12 - yearly.price} less per year than monthly`, 'Every feature and every update', 'Cancel anytime in two clicks'],
  },
  {
    plan: 'monthly',
    name: 'Monthly',
    featured: false,
    chip: 'Most flexible',
    price: monthly.price,
    was: null,
    billed: 'Billed monthly',
    perks: ['Pay as you go, month by month', 'Every feature and every update', 'Switch to yearly anytime'],
  },
] as const;
---

<section id="pricing" class="relative py-20 sm:py-28" data-track-view="pricing">
  <div class="pricing-glow pointer-events-none absolute inset-x-0 top-40 -z-10 h-[700px]" aria-hidden="true"></div>
  <div class="container-x">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow justify-center" data-reveal><span class="n">10</span> Pricing</p>
      <Words text={`Free for ${PRICING.trialDays} days. *Then one simple price.*`} class="h-section mx-auto mt-6" />
      <p class="lead mx-auto mt-6 max-w-[560px]" data-reveal style="--d:200">
        Every feature in every plan. No seats, no credits, no caps.
      </p>
    </div>

    <div class="mx-auto mt-12 grid max-w-[980px] gap-4 sm:mt-16 md:grid-cols-2 md:items-stretch">
      {
        cards.map((c, i) => (
          <div class:list={['price-card', c.featured && 'is-featured']} data-reveal style={`--d:${i * 100}`}>
            <div class="price-inner flex flex-col p-6 sm:p-10">
              <div class="flex items-center justify-between gap-3">
                <p class="text-[15px] font-medium">{c.name}</p>
                <span class:list={['chip', c.featured && 'chip-brand']}>
                  {c.featured && <Icon name="sparkles" size={11} />} {c.chip}
                </span>
              </div>
              <p class="mt-7 flex items-baseline gap-2">
                <span class="price-num">${c.price}</span>
                <span class="text-[15px] text-muted">/ month</span>
                {c.was && (
                  <s class="ml-1 text-[15px] text-dim" aria-label={`instead of $${c.was}`}>
                    ${c.was}
                  </s>
                )}
              </p>
              <p class="mt-3 text-[14px] text-text-2">
                {c.billed}
              </p>
              <CheckoutButton
                plan={c.plan}
                label={`Start ${PRICING.trialDays}-day free trial`}
                source={`pricing_${c.plan}`}
                variant={c.featured ? 'primary' : 'ghost'}
                full
                size="lg"
                class="mt-7"
              />
              <p class="mt-3 text-center text-[13px] text-muted">No charge today. Cancel anytime before day {PRICING.trialDays}.</p>
              <div class="rule my-7" />
              <ul class="space-y-3 text-[14.5px]">
                {c.perks.map((f, j) => (
                  <li class:list={['flex items-start gap-3', j ? 'text-text-2' : 'text-text']}>
                    <Icon name="check" size={16} stroke={2.2} class:list={['mt-0.5 flex-none', c.featured ? 'text-brand' : 'text-muted']} />
                    {f}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="included mx-auto mt-4 max-w-[980px] rounded-[26px] p-6 ring-1 ring-line sm:p-8" data-reveal style="--d:120">
      <p class="text-[13px] text-muted">Included in every plan</p>
      <ul class="mt-5 grid gap-x-6 gap-y-3.5 text-[14.5px] sm:grid-cols-2 lg:grid-cols-4">
        {
          included.map((f) => (
            <li class="flex items-start gap-3 text-text-2">
              <Icon name="check" size={16} stroke={2.2} class="mt-0.5 flex-none text-brand" />
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mx-auto mt-3 grid max-w-[980px] gap-3 md:grid-cols-3" data-reveal style="--d:150">
      <div class="flex items-start gap-3 rounded-2xl p-4 ring-1 ring-line">
        <Icon name="shield-check" size={18} class="mt-0.5 flex-none text-brand" />
        <p class="text-[13px] leading-relaxed text-muted">
          <span class="text-text">Try first, then a {PRICING.guaranteeDays}-day guarantee.</span> Cancel during the trial and pay nothing.
          After your first payment, email us within {PRICING.guaranteeDays} days for a full refund.
        </p>
      </div>
      <div class="flex items-start gap-3 rounded-2xl p-4 ring-1 ring-line">
        <span class="mt-0.5 grid size-[18px] flex-none place-items-center text-claude">
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2l1.9 6.2L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.8z"></path></svg>
        </span>
        <p class="text-[13px] leading-relaxed text-muted">
          <span class="text-text">Runs on your Claude plan.</span> Sign in with Claude Pro or Max, or use an Anthropic API key — not
          included. <a href="#faq" class="underline decoration-line-3 underline-offset-2 hover:text-text">Details</a>
        </p>
      </div>
      <div class="flex items-start gap-3 rounded-2xl p-4 ring-1 ring-line">
        <Icon name="receipt-text" size={18} class="mt-0.5 flex-none text-muted" />
        <p class="text-[13px] leading-relaxed text-muted">
          <span class="text-text">Business-ready.</span> Invoice with your VAT ID, paid securely via Stripe. Card, Apple Pay, Google Pay
          & more.
        </p>
      </div>
    </div>

    <p class="mt-8 text-center text-[13px] text-dim" data-reveal>
      Need it for a team? <a href={`mailto:${SITE.email}?subject=Godmode%20for%20teams`} class="underline decoration-line-3 underline-offset-2 hover:text-text" data-track="teams_mail">Talk to us</a>.
    </p>
  </div>
</section>
