---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import { PRICING } from '@/config/site';

const { monthly, yearly } = PRICING.plans;

type Cell = ['yes' | 'no' | 'partial' | '?' | 'text', string];
const cols = ['Godmode', 'ChatGPT Dots', 'Grok Bot', 'Claude Cowork'];
// Checked against each vendor's docs on October 22, 2026 (sources in the footnote below the table).
const rows: { label: string; cells: Cell[] }[] = [
  {
    label: 'Does the work on your own computer',
    cells: [
      ['yes', 'Mac · Windows · Linux'],
      ['partial', 'Cloud; can use one connected computer'],
      ['partial', 'Cloud; runs commands on yours if you approve'],
      ['partial', 'Cloud on Pro and Max; reaches your folders and browser while the app is open'],
    ],
  },
  {
    label: 'A computer of its own',
    cells: [['yes', 'A separate Mac on your Mac'], ['yes', 'Cloud computer'], ['partial', 'One cloud PC for all bots'], ['partial', 'Fresh sandbox each session']],
  },
  {
    label: 'Already signed in to your accounts',
    cells: [
      ['yes', 'Brings over your Chrome logins'],
      ['no', 'Own cloud browser, you sign in'],
      ['no', 'Own cloud browser, you sign in'],
      ['yes', 'Claude in Chrome, or imported cookies'],
    ],
  },
  {
    label: 'Passwords and 2FA codes, hidden from the AI',
    cells: [
      ['yes', 'Built-in local vault: passwords, 2FA codes, passkeys'],
      ['partial', 'Private sign-in form; you type 2FA codes'],
      ['partial', 'You type them in; not shown to the model'],
      ['partial', 'With 1Password: Mac only, you approve each fill, no passkeys'],
    ],
  },
  {
    label: 'Remembers you between tasks',
    cells: [['yes', 'Notes you can read and edit'], ['yes', ''], ['yes', ''], ['yes', 'Memory you can edit']],
  },
  {
    label: 'Runs on its own, on a schedule',
    cells: [['yes', 'Schedules · new emails · changes'], ['yes', 'Scheduled tasks'], ['yes', 'Routines: schedules and events'], ['yes', 'Scheduled tasks']],
  },
  {
    label: 'Message it from Slack · Telegram · Teams',
    cells: [['yes', 'All three'], ['partial', 'Slack · Teams'], ['partial', 'Slack'], ['partial', 'Slack, on Team and Enterprise']],
  },
  {
    label: 'Keeps working with your laptop shut',
    cells: [['partial', 'On an always-on computer'], ['yes', ''], ['yes', ''], ['yes', 'Cloud tasks, without your files or browser']],
  },
  {
    label: 'AI model',
    cells: [['text', 'Claude Opus 5.5'], ['text', 'GPT-6 Astra'], ['text', 'Picked for you: Grok or others'], ['text', 'Claude']],
  },
  {
    label: 'Price',
    cells: [
      ['text', `${PRICING.trialDays} days free, then $${yearly.perMonth}–${monthly.price}/mo`],
      ['text', 'From $100/mo (Pro, outside the EEA, UK and Switzerland)'],
      ['text', 'From $30/mo (X Premium), weekly usage pool'],
      ['text', 'In Claude Pro ($20/mo) and up'],
    ],
  },
];
const sources = [
  ['ChatGPT Dots', 'https://learn.chatgpt.com/docs/dots'],
  ['Grok Bot (xAI)', 'https://docs.x.ai/grok-bot/overview'],
  ['X Subscription', 'https://docs.x.ai/x-subscription/pricing'],
  ['Claude Cowork', 'https://support.claude.com/en/articles/15520349-use-claude-cowork-on-web-desktop-and-mobile'],
  ['1Password for Claude', 'https://support.1password.com/1password-claude/'],
];
const mark = {
  yes: { icon: 'check', cls: 'text-brand', sr: 'Yes' },
  no: { icon: 'x', cls: 'text-[rgb(240_82_91/0.8)]', sr: 'No' },
  partial: { icon: 'minus', cls: 'text-warn', sr: 'Partly' },
  '?': { icon: 'circle-help', cls: 'text-dim', sr: 'Not documented' },
} as const;
---

<section id="compare" class="relative py-20 sm:py-28" data-track-view="compare">
  <div class="container-x">
    <div class="mx-auto max-w-[820px] text-center">
      <p class="eyebrow justify-center" data-reveal><span class="n">09</span> Compare</p>
      <Words text="Others run in their cloud. *Godmode runs on your computer.*" class="h-section mx-auto mt-6" />
      <p class="lead mx-auto mt-6 max-w-[620px]" data-reveal style="--d:200">
        A team of AI coworkers with your own logins, a separate Mac of its own if you want one, and a built-in local
        vault for passwords, 2FA codes and passkeys. All in one app, on a computer you own.
      </p>
    </div>

    <a href="/vs/grok-bot" class="card group mt-12 grid gap-6 p-7 sm:p-8 md:mt-14 md:grid-cols-[1fr_auto] md:items-center" data-reveal data-track="compare_grok">
      <div>
        <p class="font-mono text-[11px] tracking-[0.12em] text-dim uppercase">Coming from Grok Bot?</p>
        <p class="h-card mt-3 text-[22px]">Same AI teammates. Your computer, your logins, no usage meter of its own.</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {['Already signed in via Chrome import', '2FA filled from the vault', 'Real desktop apps, in the background', 'Claude Opus 5.5'].map((t) => (
            <li class="chip"><Icon name="check" size={11} stroke={2.4} class="text-brand" /> {t}</li>
          ))}
        </ul>
      </div>
      <span class="btn btn-ghost self-start md:self-center">Godmode vs Grok Bot <Icon name="arrow-right" size={16} class="transition-transform group-hover:translate-x-0.5" /></span>
    </a>

    <p class="mt-8 flex items-center justify-end gap-1.5 text-[12px] text-dim md:hidden">Swipe to compare <Icon name="arrow-right" size={12} /></p>
    <div class="card mt-3 overflow-hidden" data-reveal style="--d:100">
      <div class="overflow-x-auto">
        <table class="compare w-full min-w-[820px] border-collapse text-left">
          <caption class="sr-only">Godmode compared with other AI agents</caption>
          <thead>
            <tr>
              <th scope="col" class="w-[26%]"><span class="sr-only">Feature</span></th>
              {
                cols.map((c, i) => (
                  <th scope="col" class:list={['col-head', i === 0 && 'is-us']}>
                    {i === 0 ? (
                      <span class="flex items-center gap-2">
                        <Logo size={20} />
                        {c}
                      </span>
                    ) : (
                      c
                    )}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {r.cells.map(([kind, note], i) => (
                    <td class:list={[i === 0 && 'is-us']}>
                      {kind === 'text' ? (
                        <span class:list={['text-[13.5px]', i === 0 ? 'font-medium text-text' : 'text-text-2']}>{note}</span>
                      ) : (
                        <span class="flex items-start gap-2">
                          <Icon name={mark[kind].icon} size={16} stroke={2.2} class:list={['mt-px flex-none', mark[kind].cls]} />
                          <span class="sr-only">{mark[kind].sr}.</span>
                          {note && <span class="text-[12.5px] leading-snug text-muted">{note}</span>}
                        </span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
    <p class="mt-4 text-[12px] leading-relaxed text-dim" data-reveal>
      Checked against each vendor’s docs, help center and plan pages on October 22, 2026:
      {sources.map(([name, href], i) => (
        <>
          <a href={href} rel="noopener nofollow" class="underline decoration-line-3 underline-offset-2 hover:text-text">{name}</a>{i < sources.length - 1 ? ', ' : '. '}
        </>
      ))}
      Prices exclude taxes; Godmode also needs a Claude plan or an Anthropic API key. Spotted something out of date?
      <a href="mailto:kontakt@codext.de" class="underline decoration-line-3 underline-offset-2 hover:text-text">Tell us</a>
      and we’ll fix it. All trademarks belong to their owners.
    </p>
  </div>
</section>
