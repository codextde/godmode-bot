---
import { Image } from 'astro:assets';
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import CheckoutButton from '../ui/CheckoutButton.astro';
import { PRICING } from '@/config/site';
import chat from '@/assets/shots/chat.png';
---

<section data-hero class="relative isolate overflow-hidden pt-[112px] sm:pt-[132px]">
  <!-- Light from above + dot field -->
  <div class="hero-light pointer-events-none absolute inset-x-0 top-0 -z-10 h-[980px]" aria-hidden="true"></div>
  <canvas data-dotfield class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[900px] w-full" aria-hidden="true"
  ></canvas>

  <div class="container-x relative text-center">
    <div data-reveal style="--d:0">
      <a href="#features" class="pill group mx-auto" data-track="hero_pill">
        <span class="flex items-center gap-2 rounded-full bg-[rgb(217_119_87/0.14)] py-1 pr-2.5 pl-2 text-[12.5px] whitespace-nowrap text-[#f0a488]">
          <svg width="12" height="12" viewBox="0 0 24 24" aria-hidden="true"
            ><path
              fill="currentColor"
              d="M12 2l1.9 6.2L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.8z"></path></svg
          >
          Claude Opus 5.5
        </span>
        <span class="whitespace-nowrap text-text-2"><span class="hidden sm:inline">The AI that uses your computer like you do</span><span class="sm:hidden">Your AI coworker</span></span>
        <Icon name="arrow-right" size={14} class="text-dim transition-transform duration-500 group-hover:translate-x-0.5" />
      </a>
    </div>

    <Words
      as="h1"
      text="Your next hire *isn’t human.*"
      class="h-display text-grad mx-auto mt-7 max-w-[11.5ch] pb-2"
      delay={120}
    />

    <p class="lead mx-auto mt-6 max-w-[640px]" data-reveal style="--d:450">
      Godmode is an AI coworker that works like a person on a Mac. It opens your browser, signs in with your logins
      and 2FA, clicks through your apps and keeps going until the job is done — quietly in the background, or on its
      own Mac. No workflows to build. No integrations to wire up. Just tell it what you need.
    </p>

    <div class="mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal style="--d:600">
      <CheckoutButton plan="lifetime" label={`Get Godmode — $${PRICING.plans.lifetime.price} once`} source="hero" size="lg" />
      <button type="button" class="btn btn-ghost btn-lg group" data-open-video="hero">
        <span class="play-ring grid size-7 place-items-center rounded-full bg-text text-bg">
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1.2v7.6L8.6 5z" fill="currentColor"></path></svg>
        </span>
        Watch it work
      </button>
    </div>

    <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[13px] text-muted" data-reveal style="--d:720">
      <li class="flex items-center gap-1.5"><Icon name="check" size={14} class="text-brand" /> or ${PRICING.plans.monthly.price}/month</li>
      <li class="flex items-center gap-1.5"><Icon name="check" size={14} class="text-brand" /> {PRICING.guaranteeDays}-day money-back guarantee</li>
      <li class="flex items-center gap-1.5"><Icon name="check" size={14} class="text-brand" /> macOS · Windows · Linux</li>
    </ul>
  </div>

  <!-- Product window -->
  <div class="container-x relative mt-14 sm:mt-20" data-reveal="fade" style="--d:800">
    <div class="tilt-stage">
      <div data-tilt class="tilt window relative mx-auto max-w-[1120px]">
        <div class="window-bar">
          <i></i><i></i><i></i>
          <div class="mx-auto flex items-center gap-2 font-mono text-[11px] text-dim">
            <span class="live-dot !size-1.5"></span> Godmode · working
          </div>
        </div>
        <div class="relative aspect-video bg-bg">
          <Image
            src={chat}
            alt="Godmode logging into a billing portal: the password and 2FA code are filled from the encrypted vault and marked ‘Secret hidden’, next to a live preview of its browser."
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(min-width: 1200px) 1120px, 94vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 size-full object-cover object-top"
          />
          <video
            class="hero-video absolute inset-0 size-full object-cover"
            muted
            playsinline
            loop
            autoplay
            preload="metadata"
            data-autoplay
            aria-label="Godmode completing a task: it signs into a billing portal with a hidden password and 2FA code, downloads invoices and posts them to Slack."
          >
            <source src="/media/hero.webm" type="video/webm" />
            <source src="/media/hero.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <!-- Floating status chips -->
      <div class="float-chip left-[2%] top-[18%] hidden md:flex" style="--fd:0s">
        <span class="grid size-7 place-items-center rounded-lg bg-brand-soft text-brand"><Icon name="lock-keyhole" size={15} /></span>
        <span class="text-left">
          <b class="block text-[13px] font-medium text-text">Password filled</b>
          <span class="font-mono text-[11px] text-dim">secret hidden from the AI</span>
        </span>
      </div>
      <div class="float-chip right-[1%] top-[42%] hidden md:flex" style="--fd:-2s">
        <span class="grid size-7 place-items-center rounded-lg bg-brand-soft text-brand"><Icon name="shield-check" size={15} /></span>
        <span class="text-left">
          <b class="block text-[13px] font-medium text-text">2FA code <span class="font-mono tracking-widest text-brand">••• •••</span></b>
          <span class="font-mono text-[11px] text-dim">typed from your vault</span>
        </span>
      </div>
      <div class="float-chip bottom-[10%] left-[6%] hidden lg:flex" style="--fd:-4s">
        <span class="grid size-7 place-items-center rounded-lg bg-[rgb(255_250_240/0.06)] text-text-2"><Icon name="mouse-pointer-2" size={15} /></span>
        <span class="text-left">
          <b class="block text-[13px] font-medium text-text">Your cursor is free</b>
          <span class="font-mono text-[11px] text-dim">working in the background</span>
        </span>
      </div>
    </div>
  </div>
</section>
