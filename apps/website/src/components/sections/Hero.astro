---
import { Image } from 'astro:assets';
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import Character from '../ui/Character.astro';
import DownloadButton from '../ui/DownloadButton.astro';
import { PRICING } from '@/config/site';
import recording from '@/assets/shots/hero-recording.jpg';
---

<section data-hero class="relative isolate overflow-hidden pt-[112px] sm:pt-[140px]">
  <div class="hero-wash pointer-events-none absolute inset-x-0 top-0 -z-10 h-[900px]" aria-hidden="true"></div>

  <div class="container-x relative text-center">
    <div data-reveal style="--d:0">
      <a href="#jobs" class="pill group mx-auto" data-track="hero_pill">
        <span class="rounded-full bg-brand-soft px-2.5 py-1 text-[12.5px] font-semibold text-brand">New</span>
        <span class="whitespace-nowrap text-text-2"><span class="sm:hidden">Your AI coworker</span><span class="hidden sm:inline">Your AI coworker for everyday computer work</span></span>
        <Icon name="arrow-right" size={14} class="text-dim transition-transform duration-500 group-hover:translate-x-0.5" />
      </a>
    </div>

    <Words as="h1" text="Your computer work. *Done for you.*" class="h-display mx-auto mt-7 max-w-[12ch] pb-2" delay={120} />

    <p class="lead mx-auto mt-6 max-w-[620px] !text-text-2" data-reveal style="--d:450">
      Tell Godmode what you need in plain words. It opens your browser and apps, signs in, clicks through and finishes the
      job, while you do something else.
    </p>

    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row" data-reveal style="--d:600">
      <DownloadButton source="hero" size="xl" />
      <button type="button" class="btn btn-ghost btn-lg group" data-open-video="hero">
        <span class="play-ring grid size-7 place-items-center rounded-full bg-brand text-white">
          <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 1.2v7.6L8.6 5z" fill="currentColor"></path></svg>
        </span>
        Watch it work
      </button>
    </div>

    <p class="hero-note mt-5" data-reveal style="--d:680">
      <span><Icon name="check" size={15} class="text-brand" stroke={2.4} /> Free for {PRICING.freeDays} days</span>
      <span aria-hidden="true" class="text-line-3">·</span>
      <span><Icon name="check" size={15} class="text-brand" stroke={2.4} /> No card</span>
      <span aria-hidden="true" class="text-line-3">·</span>
      <span><Icon name="check" size={15} class="text-brand" stroke={2.4} /> No sign-up</span>
    </p>
    <p class="mt-2 text-[13px] text-dim" data-reveal style="--d:720">For Mac with Apple chip or Intel. No coding needed.</p>
  </div>

  <div class="container-x relative mt-16 sm:mt-20" data-reveal="fade" style="--d:800">
    <div class="tilt-stage">
      <div class="window hero-window relative mx-auto max-w-[1080px]">
        <div class="hero-mascot" data-mascot aria-hidden="true">
          <Character size={92} follow class="mascot-idle" seed="hero" />
          <Character size={92} mood="happy" class="mascot-happy" seed="hero" />
          <span class="say"><span class="sm:hidden">Hi, I’m Godmode!</span><span class="hidden sm:inline">Hi, I’m Godmode. Hand me the busywork.</span></span>
        </div>
        <div class="window-bar traffic">
          <i></i><i></i><i></i>
          <div class="mx-auto flex items-center gap-2 text-[12px] font-medium text-muted">
            <span class="live-dot !size-1.5"></span> Real screen recording, sped up
          </div>
        </div>
        <div class="hero-screen relative aspect-video bg-surface-3">
          <Image
            src={recording}
            alt="A real Mac desktop: Godmode looked up Notion, Linear and Slack pricing in its own Chrome window and answered with a table of what a 10-person team pays per month."
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(min-width: 1200px) 1080px, 94vw"
            loading="eager"
            fetchpriority="high"
            class="absolute inset-0 size-full object-cover object-top"
          />
          <video
            class="hero-video absolute inset-0 size-full object-cover"
            muted
            playsinline
            loop
            autoplay
            preload="metadata"
            data-autoplay
            aria-label="Real screen recording, sped up: Godmode opens Notion, Linear and Slack pricing in its own browser and answers with a table of what a 10-person team pays per month."
          >
            <source src="/media/hero.webm" type="video/webm" />
            <source src="/media/hero.mp4" type="video/mp4" />
          </video>
        </div>
      </div>

      <div class="float-chip left-[0%] top-[22%] hidden lg:flex" style="--fd:0s">
        <span class="grid size-8 place-items-center rounded-xl bg-brand-soft text-brand"><Icon name="key-round" size={16} /></span>
        <span class="text-left">
          <b class="block text-[13.5px] font-semibold text-text">Signs in for you</b>
          <span class="text-[12px] text-muted">never sees your passwords</span>
        </span>
      </div>
      <div class="float-chip right-[0%] top-[46%] hidden lg:flex" style="--fd:-2s">
        <span class="grid size-8 place-items-center rounded-xl bg-peach-soft text-[#8a3d1f]"><Icon name="hand" size={16} /></span>
        <span class="text-left">
          <b class="block text-[13.5px] font-semibold text-text">Checks with you</b>
          <span class="text-[12px] text-muted">by default, before it sends or pays</span>
        </span>
      </div>
    </div>
  </div>
</section>
