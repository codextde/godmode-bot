---
import { Image } from 'astro:assets';
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import BrandMark from '../ui/BrandMark.astro';
import { LEGAL, PRICING, SITE } from '@/config/site';
import daniel from '@/assets/daniel-ehrhardt.webp';
import premier from '@/assets/brand/shopify-premier.svg?raw';
import { langOf } from '@/i18n';

const lang = langOf(Astro.url);
const place = LEGAL.city.replace(/^\d+\s/, '');
const reg = LEGAL.registry.split(',')[0];
const t = {
  en: {
    eyebrow: 'Who is behind it',
    h: 'Made by a real company. *Used there every day.*',
    quote:
      'We built Godmode for our own team first. Today it does a big part of the office work at Codext: it drafts our monthly invoices, works through our ticket inbox and answers our shop customers. If something doesn’t work for you, write to us. A real person answers, usually within a day.',
    role: `Founder and managing director, ${LEGAL.company}`,
    shops: ['Our team also builds online shops as a', 'Shopify Premier Partner', '. Questions about Godmode:'],
    facts: [
      { icon: 'shield-check', title: 'Notarized by Apple', text: `The Mac app is signed by ${LEGAL.company}, and Apple checks it before it opens.` },
      { mark: 'github', title: 'Open source (MIT)', text: 'Every line of code is public on GitHub. Read it, or build the app yourself.', href: SITE.repo, cta: 'View the code' },
      { icon: 'refresh-cw', title: 'Updated every week', text: '30+ releases since September 2026, with fixes for what users tell us.', href: '/changelog', cta: 'What’s new' },
      { icon: 'building-2', title: 'A company you can call', text: `${LEGAL.company}, ${place}, Germany. ${reg}. Phone ${LEGAL.phone}.`, href: '/legal/imprint', cta: 'Imprint' },
      {
        icon: 'rotate-ccw',
        title: `${PRICING.guaranteeDays}-day money-back`,
        text: `Free for ${PRICING.freeDays} days without a card. Changed your mind after paying? Email us within ${PRICING.guaranteeDays} days of your first payment for a full refund.`,
        href: '/legal/refunds',
        cta: 'Refund policy',
      },
    ],
  },
  de: {
    eyebrow: 'Wer dahintersteht',
    h: 'Von einer echten Firma. *Dort jeden Tag im Einsatz.*',
    quote:
      'Wir haben Godmode zuerst für unser eigenes Team gebaut. Heute erledigt er einen großen Teil der Büroarbeit bei Codext: Er bereitet unsere Monatsrechnungen vor, arbeitet unser Ticket-Postfach ab und beantwortet Fragen unserer Shop-Kunden. Wenn etwas bei dir nicht klappt, schreib uns. Ein echter Mensch antwortet, meist innerhalb eines Tages.',
    role: `Gründer und Geschäftsführer, ${LEGAL.company}`,
    shops: ['Unser Team baut außerdem Onlineshops als', 'Shopify Premier Partner', '. Fragen zu Godmode:'],
    facts: [
      { icon: 'shield-check', title: 'Von Apple notarisiert', text: `Die Mac-App ist von der ${LEGAL.company} signiert, und Apple prüft sie, bevor sie startet.` },
      { mark: 'github', title: 'Open Source (MIT)', text: 'Der gesamte Code ist öffentlich auf GitHub. Lies ihn oder baue die App selbst.', href: SITE.repo, cta: 'Code ansehen' },
      { icon: 'refresh-cw', title: 'Jede Woche neue Updates', text: 'Über 30 Versionen seit September 2026, mit Verbesserungen aus dem Feedback der Nutzer.', href: '/changelog', cta: 'Was ist neu' },
      { icon: 'building-2', title: 'Eine Firma, die du anrufen kannst', text: `${LEGAL.company}, ${place}, Deutschland. ${reg}. Telefon ${LEGAL.phone}.`, href: '/legal/imprint', cta: 'Impressum' },
      {
        icon: 'rotate-ccw',
        title: `${PRICING.guaranteeDays} Tage Geld zurück`,
        text: `${PRICING.freeDays} Tage kostenlos, ohne Karte. Nach dem Bezahlen umentschieden? Schreib uns innerhalb von ${PRICING.guaranteeDays} Tagen nach der ersten Zahlung und du bekommst alles zurück.`,
        href: '/legal/refunds',
        cta: 'Rückerstattung',
      },
    ],
  },
}[lang];
type Fact = { icon?: string; mark?: 'github' | 'claude'; title: string; text: string; href?: string; cta?: string };
const facts: Fact[] = t.facts as Fact[];
---

<section id="proof" class="relative py-16 sm:py-24" data-track-view="proof">
  <div class="container-x">
    <div class="mx-auto max-w-[760px] text-center">
      <p class="eyebrow justify-center" data-reveal>{t.eyebrow}</p>
      <Words text={t.h} class="h-section mx-auto mt-4" />
    </div>

    <div class="mt-14 grid gap-4 lg:grid-cols-[1.05fr_0.95fr]">
      <figure class="card founder-card p-7 sm:p-10" data-reveal>
        <svg class="founder-quote-mark" width="44" height="34" viewBox="0 0 44 34" aria-hidden="true"><path fill="currentColor" d="M0 34V20.6C0 8.6 6.4 1.8 17.4 0l1.8 5.2C13 7 10 10.8 9.8 16H18v18H0zm25.4 0V20.6C25.4 8.6 31.8 1.8 42.8 0l1.2 5.2C38.2 7 35.4 10.8 35.2 16H43.4v18H25.4z"></path></svg>
        <blockquote class="mt-5 text-[clamp(19px,2vw,23px)] font-medium leading-[1.45] tracking-[-0.02em] text-text">
          {t.quote}
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-4">
          <Image src={daniel} alt="Daniel Ehrhardt" width={112} height={112} class="founder-photo" />
          <span>
            <span class="serif block text-[26px] leading-none text-text">Daniel Ehrhardt</span>
            <span class="mt-1.5 block text-[14px] text-muted">{t.role}</span>
          </span>
          <span class="premier ml-auto hidden sm:block" set:html={premier} title="Shopify Premier Partner" />
        </figcaption>
        <p class="mt-6 border-t border-line pt-5 text-[13.5px] leading-relaxed text-muted">
          {t.shops[0]} <span class="font-medium text-text-2">{t.shops[1]}</span>{t.shops[2]}
          <a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </figure>

      <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          facts.map((f, i) => {
            const body = (
              <>
                <span class="proof-icon">
                  {f.mark ? <BrandMark name={f.mark} size={18} /> : <Icon name={f.icon ?? 'check'} size={18} />}
                </span>
                <span class="min-w-0">
                  <span class="block text-[15.5px] font-semibold tracking-[-0.015em] text-text">{f.title}</span>
                  <span class="mt-1 block text-[14px] leading-relaxed text-muted">{f.text}</span>
                  {f.cta && (
                    <span class="mt-2 inline-flex items-center gap-1 text-[13px] font-semibold text-brand">
                      {f.cta} <Icon name="arrow-up-right" size={13} class="arrow" />
                    </span>
                  )}
                </span>
              </>
            );
            return (
              <li data-reveal style={`--d:${i * 60}`} class:list={[i === facts.length - 1 && 'xl:col-span-2']}>
                {f.href ? (
                  <a href={f.href} class="proof-fact card card-hover" {...(f.href.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})} data-track={`proof_${i}`}>
                    {body}
                  </a>
                ) : (
                  <div class="proof-fact card">{body}</div>
                )}
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>
