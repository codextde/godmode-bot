---
import Words from '../ui/Words.astro';
import WaitlistForm from '../ui/WaitlistForm.astro';
import { PRICING, SITE } from '@/config/site';

const { monthly, yearly } = PRICING.plans;

const faqs: { key: string; q: string; a: string; waitlist?: boolean }[] = [
  {
    key: 'code',
    q: 'Do I need to know how to code?',
    a: 'No. If you can explain the task to a colleague, you can hand it to Godmode. You type or say what you need in plain words, and it does the clicking. Setup is a normal Mac app install and walks you through the rest.',
  },
  {
    key: 'chatgpt',
    q: 'How is this different from ChatGPT?',
    a: 'ChatGPT answers in a chat window, and then you do the work. Godmode does the work: it signs in to the websites and programs you use, clicks through, finishes the task and hands you the result. It can also do it again by itself every week, or whenever an email arrives.',
  },
  {
    key: 'after',
    q: `What happens after ${PRICING.freeDays} days?`,
    a: `Godmode asks if you want to keep it. Pick monthly ($${monthly.price} a month) or yearly ($${yearly.perMonth} a month, billed $${yearly.price} once a year). If you don’t, nothing is charged, because you never gave us a card. Everything you set up stays on your Mac, so you can pick up where you left off.`,
  },
  {
    key: 'card',
    q: 'Do I need a credit card to try it?',
    a: `No. Download it and use every feature free for ${PRICING.freeDays} days. No card, no account. You only enter payment details if you decide to keep it.`,
  },
  {
    key: 'claude',
    q: 'Do I need a Claude plan?',
    a: 'Yes. Godmode thinks with Claude, the AI from Anthropic. You sign in with your Claude Pro or Max plan once during setup. No plan yet? The setup shows you how to get one. If Godmode works for you all day, Max fits better than Pro. An Anthropic API key works too.',
  },
  {
    key: 'safe',
    q: 'Is my data safe? Does it see my passwords?',
    a: 'Your passwords and 2FA codes live in an encrypted vault on your Mac. Godmode types them into the login page itself, so the AI only learns that a password was filled, never what it is, and only on that login’s own website. Your logins, notes and history stay on your computer, and the app sends nothing to us. The tasks you give and the pages it reads are processed by Claude under your own Claude account.',
  },
  {
    key: 'ask',
    q: 'Will it do things without asking me?',
    a: 'By default it asks you before important steps like sending an email, paying, deleting or posting. If your task already says to do that step (“send the reminders”), it goes ahead. You can watch every step live and take over with one click. When a website wants a code from your phone, it asks you for that too.',
  },
  {
    key: 'windows',
    q: 'Does it work on Windows?',
    a: 'Not yet. Godmode is for Mac for now, with Apple chip or Intel. Leave your email and we’ll tell you when the Windows version is ready.',
    waitlist: true,
  },
  {
    key: 'team',
    q: 'Can my team use it?',
    a: `Yes. Each person installs Godmode on their own Mac and gets the same ${PRICING.freeDays} free days. For several people on one invoice, email ${SITE.email} and we’ll set it up with you.`,
  },
  {
    key: 'cancel',
    q: 'How do I cancel?',
    a: `In two clicks, in the billing portal (linked in the app and in your receipt), or by email. It keeps working until the end of the month or year you paid for. And if it’s not for you, email us within ${PRICING.guaranteeDays} days of your first payment and we refund it in full, no questions asked.`,
  },
  {
    key: 'offline',
    q: 'Does it work when my Mac is off?',
    a: 'It works while your Mac is on and awake. Want it working around the clock? Run it on a spare Mac that stays on, like a Mac mini, and reach it from your phone. Email us and we’ll help you set it up.',
  },
  {
    key: 'cant',
    q: 'What can’t it do?',
    a: 'Some websites block robots with puzzles (CAPTCHAs) or want a code from your phone. Then you click “Take control” for a moment and it carries on. Like any AI it can make mistakes, so check important work until you trust a routine.',
  },
  {
    key: 'invoice',
    q: 'Can I get an invoice for my company?',
    a: 'Yes. Add your company name and VAT ID at checkout and you get a proper invoice by email. Payments are handled by Stripe; we never see your card.',
  },
];
---

<section id="faq" class="relative py-16 sm:py-24" data-track-view="faq">
  <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="eyebrow" data-reveal>Questions</p>
      <Words text="Good questions. *Straight answers.*" class="h-section mt-4" />
      <p class="mt-6 max-w-[360px] text-[16px] leading-relaxed text-muted" data-reveal style="--d:200">
        Something else? Email <a href={`mailto:${SITE.email}`} class="font-medium text-text underline decoration-line-3 underline-offset-2">{SITE.email}</a>.
        A human answers, usually within a day.
      </p>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {
        faqs.map((f, i) => (
          <details class="faq group" id={`faq-${f.key}`} data-faq={f.key} data-reveal style={`--d:${Math.min(i, 6) * 40}`}>
            <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-[18px] font-semibold tracking-[-0.015em] transition-colors hover:text-brand">
              {f.q}
              <span class="plus grid size-8 flex-none place-items-center rounded-full bg-surface ring-1 ring-line-2 transition-colors group-hover:ring-line-3" aria-hidden="true">
                <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
              </span>
            </summary>
            <div class="max-w-[640px] pb-7">
              <p class="text-[16px] leading-[1.7] text-muted">{f.a}</p>
              {f.waitlist && <WaitlistForm source="windows" class="mt-5" />}
            </div>
          </details>
        ))
      }
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  })} />
</section>
