---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import { LEGAL } from '@/config/site';

const points = [
  {
    icon: 'lock-keyhole',
    title: 'Your passwords stay on your computer',
    text: 'They live in an encrypted vault on your Mac. Godmode types them into the login page itself, so the AI never sees them. In chats and logs they are blacked out.',
  },
  {
    icon: 'hand',
    title: 'It asks before anything important',
    text: 'Sending, paying, deleting, posting: by default it stops and asks you first. You can watch every step and take over with one click.',
  },
  {
    icon: 'laptop',
    title: 'It runs on your own Mac',
    text: 'Your logins, notes and history stay on your computer. The app has no tracking and sends nothing to us.',
  },
  {
    icon: 'building-2',
    title: `Made by ${LEGAL.company} in Germany`,
    text: 'A real company you can call. Questions go to a human, usually answered within a day.',
  },
];
---

<section id="trust" class="relative py-16 sm:py-24" data-track-view="security">
  <div class="container-x">
    <div class="grid items-start gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div class="lg:sticky lg:top-28">
        <p class="eyebrow" data-reveal>Safe by design</p>
        <Words text="You stay *in charge.*" class="h-section mt-4" />
        <p class="lead mt-5 max-w-[440px]" data-reveal style="--d:200">
          Handing work to an AI should feel like handing it to a careful colleague. So Godmode keeps your keys at home and
          checks with you before the big steps.
        </p>

        <div class="card mt-8 max-w-[460px] p-5" data-reveal style="--d:250">
          <p class="text-[12.5px] font-semibold text-muted">What the AI sees when it signs in</p>
          <div class="mt-3 space-y-2 text-[14px] leading-relaxed text-text-2">
            <p><span class="font-semibold text-text">You:</span> Log into the supplier portal and download September’s invoice.</p>
            <p>
              <span class="font-semibold text-brand">Godmode:</span> Filled your login <span class="redact">[secret hidden]</span>
            </p>
            <p>
              <span class="font-semibold text-brand">Godmode:</span> Filled the 2FA code <span class="redact">[secret hidden]</span>
            </p>
            <p><span class="font-semibold text-brand">Godmode:</span> Signed in. Invoice saved to Documents.</p>
          </div>
        </div>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          points.map((p, i) => (
            <div class="card p-6 sm:p-7" data-reveal style={`--d:${(i % 2) * 80 + Math.floor(i / 2) * 60}`}>
              <span class="grid size-11 place-items-center rounded-2xl bg-brand-soft text-brand">
                <Icon name={p.icon} size={20} />
              </span>
              <h3 class="mt-5 text-[17px] font-semibold tracking-[-0.015em]">{p.title}</h3>
              <p class="mt-2 text-[15px] leading-relaxed text-muted">{p.text}</p>
            </div>
          ))
        }
        <p class="flex items-center gap-2 text-[13.5px] text-muted sm:col-span-2" data-reveal>
          <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" class="text-claude"><path fill="currentColor" d="M12 2l1.9 6.2L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.8z"></path></svg>
          Powered by Claude from Anthropic. Your tasks are processed under your own Claude account.
        </p>
      </div>
    </div>
  </div>
</section>
