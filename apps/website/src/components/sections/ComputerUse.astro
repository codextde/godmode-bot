---
import Words from '../ui/Words.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  title?: string;
  table?: boolean;
}
const { title = 'Chatbots tell you how. *Godmode does it.*', table = true } = Astro.props;

const modes = [
  {
    icon: 'globe',
    title: 'Your websites, signed in',
    text: 'Email, online banking, your shop, supplier portals, ad accounts. It uses your own logins, so there is no setup per website.',
    how: 'any website · your logins',
  },
  {
    icon: 'app-window',
    title: 'Your programs, in the background',
    text: 'Excel, Word, Outlook, your accounting software. It clicks and types into the window while you keep using your mouse.',
    how: 'desktop apps · mouse stays yours',
  },
  {
    icon: 'monitor',
    title: 'Your whole screen',
    text: 'When a job spans several programs, it works on your screen like a colleague on a screen share. You see every move.',
    how: 'watch live · take over anytime',
  },
  {
    icon: 'monitor-smartphone',
    title: 'A computer of its own',
    text: 'On a Mac, give it a separate Mac of its own with one click. It works in there all day and never gets in your way.',
    how: 'one click · Apple silicon',
  },
];

const versus: [string, string, string][] = [
  ['Who does the work', 'It tells you the steps, you do the clicking', 'It does the steps and hands you the result'],
  ['Logins', 'You log in yourself, or paste passwords into the chat', 'Signs in with your saved logins and 2FA codes; the AI never sees them'],
  ['Your tools', 'Only what you copy into the chat window', 'Your websites, your programs, your files'],
  ['When it gets stuck', 'You start over', 'It asks you, or you take over for a moment and it carries on'],
  ['Next week', 'You ask again', 'It runs by itself: on a schedule, when an email arrives, when something changes'],
];
---

<section id="computer-use" class="relative py-20 sm:py-28" data-track-view="computer_use">
  <div class="container-x">
    <div class="grid items-end gap-8 lg:grid-cols-[1.15fr_0.85fr]">
      <div class="max-w-[760px]">
        <p class="eyebrow" data-reveal>Where it works</p>
        <Words text={title} class="h-section mt-4" />
      </div>
      <p class="lead max-w-[440px]" data-reveal style="--d:150">
        Godmode uses a computer the way you do. It works where your work already is: in your browser, in your programs,
        on your screen, or on a computer of its own.
      </p>
    </div>

    <div class="mt-14 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {
        modes.map((m, i) => (
          <article class="card flex flex-col p-7" data-reveal style={`--d:${i * 70}`}>
            <span class="grid size-10 place-items-center rounded-xl bg-brand-soft text-brand">
              <Icon name={m.icon} size={18} />
            </span>
            <h3 class="h-card mt-5">{m.title}</h3>
            <p class="mt-2.5 flex-1 text-[15px] leading-relaxed text-muted">{m.text}</p>
            <p class="mt-5 border-t border-line pt-4 text-[12.5px] font-medium text-dim">{m.how}</p>
          </article>
        ))
      }
    </div>

    {
      table && (
    <div class="card mt-3 overflow-hidden" data-reveal style="--d:100">
      <div class="overflow-x-auto">
        <table class="compare w-full min-w-[720px] border-collapse text-left">
          <caption class="sr-only">An AI chatbot compared with Godmode</caption>
          <thead>
            <tr>
              <th scope="col" class="w-[18%]"><span class="sr-only">Topic</span></th>
              <th scope="col" class="col-head w-[41%]">An AI chatbot</th>
              <th scope="col" class="col-head is-us w-[41%]"><span class="flex items-center gap-2"><Logo size={20} /> Godmode</span></th>
            </tr>
          </thead>
          <tbody>
            {
              versus.map(([topic, diy, us]) => (
                <tr>
                  <th scope="row">{topic}</th>
                  <td>
                    <span class="flex items-start gap-2.5">
                      <Icon name="minus" size={16} stroke={2.2} class="mt-0.5 flex-none text-warn" />
                      <span class="text-[13.5px] leading-snug text-muted">{diy}</span>
                    </span>
                  </td>
                  <td class="is-us">
                    <span class="flex items-start gap-2.5">
                      <Icon name="check" size={16} stroke={2.2} class="mt-0.5 flex-none text-brand" />
                      <span class="text-[13.5px] leading-snug text-text-2">{us}</span>
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
      )
    }
  </div>
</section>
