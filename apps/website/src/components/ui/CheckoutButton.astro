---
// Website checkouts are billed today (trial=0): people get their free period by downloading the app.
import type { Plan } from '@/config/site';
import Icon from './Icon.astro';

interface Props {
  plan: Plan;
  label: string;
  source: string;
  variant?: 'primary' | 'ghost' | 'brand' | 'link';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  full?: boolean;
}
const { plan, label, source, variant = 'primary', size = 'md', class: className = '', full = false } = Astro.props;
---

<form method="post" action="/api/checkout" data-checkout={source} class:list={[full && 'w-full', className]}>
  <input type="hidden" name="plan" value={plan} />
  <input type="hidden" name="trial" value="0" />
  {
    variant === 'link' ? (
      <button type="submit" class="link-btn">
        <span class="btn-label">{label}</span>
      </button>
    ) : (
      <button
        type="submit"
        class:list={['btn group', `btn-${variant}`, size === 'lg' && 'btn-lg', size === 'sm' && 'btn-sm', full && 'w-full']}
      >
        <span class="btn-label">{label}</span>
        <Icon name="arrow-right" size={16} class="arrow" />
        <span class="btn-spinner" aria-hidden="true" />
      </button>
    )
  }
</form>
