---
// The main call to action. Without JS it downloads the Apple silicon build; main.ts sends phones and
// non-Mac computers to /download, and Macs to /download?start=1 (download starts there, with the install guide).
import Icon from './Icon.astro';
import { langOf } from '@/i18n';

interface Props {
  source: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'primary' | 'ghost' | 'dark';
  class?: string;
  full?: boolean;
}
const lang = langOf(Astro.url);
const { source, label = lang === 'de' ? 'Für Mac laden – kostenlos' : 'Download for Mac — free', size = 'lg', variant = 'primary', class: className = '', full = false } = Astro.props;
---

<a
  href="/download/mac"
  data-dl
  data-track={`download_${source}`}
  class:list={['btn group', `btn-${variant}`, size !== 'md' && `btn-${size}`, full && 'w-full', className]}
>
  <svg width={size === 'xl' ? 20 : 17} height={size === 'xl' ? 20 : 17} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M16.37 12.6c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.47.83-.72 0-1.82-.81-3-.79-1.54.02-2.96.9-3.76 2.28-1.6 2.78-.41 6.9 1.15 9.16.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.23-.02 2.01-1.12 2.76-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.4-.92-2.42-3.65zM14.1 5.85c.63-.77 1.06-1.83.94-2.9-.91.04-2.01.61-2.66 1.37-.58.67-1.1 1.76-.96 2.8 1.01.08 2.05-.52 2.68-1.27z" />
  </svg>
  <span>{label}</span>
  <Icon name="arrow-down" size={size === 'xl' ? 19 : 16} class="arrow-dl opacity-80" />
</a>
