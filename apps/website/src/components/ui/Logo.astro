  <rect x="16" y="16" width="480" height="480" rx="112" fill="#2453D6"></rect>
  <g class="logo-eyes" fill="#FFFFFF">
    <ellipse cx="152" cy="214" rx="40" ry="48"></ellipse>
    <ellipse cx="360" cy="214" rx="40" ry="48"></ellipse>
  </g>
  <path d="M204 306Q256 358 308 306" stroke="#FFFFFF" stroke-width="30" stroke-linecap="round"></path>
</svg>
