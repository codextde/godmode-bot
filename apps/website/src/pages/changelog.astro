---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config/site';

// Built from the GitHub releases when the site is built: one API call per build, so the page doesn't depend on
// GitHub's rate limit for Cloudflare's shared IPs at request time. A release published after the last deploy shows up
// with the next one; the link at the top always leads to the full list on GitHub.
type Release = { tag_name: string; html_url: string; body: string | null; published_at: string | null; draft: boolean; prerelease: boolean };

const allReleases = `${SITE.repo}/releases`;
let releases: Release[] = [];
try {
  const res = await fetch('https://api.github.com/repos/codextde/godmode-bot/releases?per_page=30', {
    headers: { accept: 'application/vnd.github+json', 'user-agent': 'godmode-website', 'x-github-api-version': '2022-11-28' },
  });
  if (!res.ok) throw new Error(`GitHub releases: ${res.status}`);
  releases = ((await res.json()) as Release[]).filter((r) => !r.draft && !r.prerelease && r.published_at);
} catch (e) {
  console.warn('changelog: could not read the GitHub releases, the page only links to them', e);
}

/** What's worth reading here from a release's notes: its highlights, or else its list of changes. */
function highlights(md: string): string[] {
  const sections = new Map<string, string[]>();
  let current = '';
  const notes = md.replace(/\r/g, '').replace(/<!-- downloads -->[\s\S]*?<!-- \/downloads -->/, '');
  for (const line of notes.split('\n')) {
    const heading = /^#{1,6}\s+(.*)$/.exec(line);
    if (heading) {
      current = heading[1].trim().toLowerCase().replace('’', "'");
      continue;
    }
    const bullet = /^\s*[-*]\s+(.*)$/.exec(line);
    if (bullet && current) sections.set(current, [...(sections.get(current) ?? []), bullet[1].trim()]);
  }
  const list = [...sections].find(([h]) => h.startsWith('highlights')) ?? [...sections].find(([h]) => h.startsWith("what's changed"));
  // GitHub's generated lines end in "by @user in https://github.com/…/pull/123": keep the number only.
  return (list?.[1] ?? []).map((t) => t.replace(/ by @[\w-]+ in https:\/\/github\.com\/\S+\/pull\/(\d+)$/, ' (#$1)'));
}

// Release notes are Markdown; render the bits we use (bold, code, links, #123) and escape the rest.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
const inline = (s: string) =>
  esc(s)
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\[([^\]]+)\]\((https?:[^)\s]+)\)/g, '<a href="$2" rel="noopener">$1</a>')
    .replace(/(^|[\s(,])#(\d+)\b/g, `$1<a href="${SITE.repo}/pull/$2" rel="noopener">#$2</a>`);
const date = (iso: string) => new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Changelog" description="What's new in Godmode: every release, newest first.">
  <Nav home={false} />
  <main class="pt-36 pb-16">
    <div class="container-x max-w-[760px]">
      <p class="eyebrow">Changelog</p>
      <h1 class="h-section mt-5">What’s new</h1>
      <p class="lead mt-4">
        Godmode updates itself in the background. Here’s what each release brought. Full notes and downloads for every
        release are on <a href={allReleases} rel="noopener" class="text-text underline decoration-line-3 underline-offset-3 hover:decoration-brand">GitHub</a>.
      </p>
      {
        releases.length === 0 && (
          <p class="mt-12 text-muted">
            The release notes are on <a href={allReleases} rel="noopener" class="text-text underline decoration-line-3 underline-offset-3 hover:decoration-brand">GitHub</a>.
          </p>
        )
      }
      <div class="mt-14 space-y-14">
        {
          releases.map((r) => (
            <article id={r.tag_name} class="scroll-mt-28">
              <div class="flex items-baseline gap-3">
                <h2 class="text-[22px] font-semibold tracking-[-0.03em]">{r.tag_name}</h2>
                <span class="text-[13px] text-dim">{date(r.published_at!)}</span>
              </div>
              <div class="prose-gm mt-4">
                <ul set:html={highlights(r.body ?? '').map((t) => `<li>${inline(t)}</li>`).join('\n')} />
                <p>
                  <a href={r.html_url} rel="noopener">Full release notes and downloads</a>
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</Base>
