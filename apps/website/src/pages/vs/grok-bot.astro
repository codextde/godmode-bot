---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import Logo from '@/components/ui/Logo.astro';
import Words from '@/components/ui/Words.astro';
import CheckoutButton from '@/components/ui/CheckoutButton.astro';
import ComputerUse from '@/components/sections/ComputerUse.astro';
import { PRICING, SITE, yearlySavings } from '@/config/site';

const { monthly, yearly } = PRICING.plans;
const checked = 'October 8, 2026';

type Mark = 'yes' | 'no' | 'partial';
const rows: { label: string; us: [Mark, string]; them: [Mark, string] }[] = [
  {
    label: 'Where the work happens',
    us: ['yes', 'On your Mac, Windows or Linux computer, plus isolated macOS VMs on your Mac'],
    them: ['partial', 'One cloud computer that all your Bots share'],
  },
  {
    label: 'Your existing logins',
    us: ['yes', 'Import your Chrome profile and continue your sessions, already signed in'],
    them: ['no', 'A fresh cloud browser. You sign in to every site again'],
  },
  {
    label: 'Passwords and 2FA codes',
    us: ['yes', 'Encrypted vault on your device fills them into the page. The model only sees [secret hidden]'],
    them: ['partial', 'Passwords from 1Password once you approve each fill. For passkeys and 2FA codes you take over and type them'],
  },
  {
    label: 'Desktop apps',
    us: ['yes', 'Any app window on your computer, controlled in the background. Your cursor stays yours'],
    them: ['partial', 'Only apps installed on the cloud computer'],
  },
  {
    label: 'Its own machine',
    us: ['yes', 'Isolated macOS VMs on your Mac, one click (Apple silicon)'],
    them: ['partial', 'A shared cloud computer, one computer-use task per Bot screen at a time'],
  },
  {
    label: 'Model',
    us: ['yes', `${SITE.model} on every task, through Anthropic’s official Claude Code, and every newer Claude the day you get it`],
    them: ['partial', 'Picked per task by xAI: a fast Grok 4.8 for most requests, Claude Opus 5.5 and others for some'],
  },
  {
    label: 'Usage limits',
    us: ['yes', 'No Godmode cap. You use your own Claude plan or API key'],
    them: ['no', 'Weekly allowance with no published number, then pay-as-you-go'],
  },
  {
    label: 'Automations',
    us: ['yes', 'Schedules, app events (new email, Slack message), webhooks and plain-language conditions'],
    them: ['yes', 'Re-run a learned skill on a schedule'],
  },
  {
    label: 'A team of agents',
    us: ['yes', 'Agents with roles and leads. A chief of staff creates and supervises them for you'],
    them: ['yes', 'Named Bots that hand off work to each other'],
  },
  {
    label: 'Memory you can read',
    us: ['yes', 'Each agent’s memory is a git repo: read it, edit it, roll it back'],
    them: ['partial', 'Preferences and summaries kept by the service'],
  },
  {
    label: 'Your data',
    us: ['yes', 'Vault, browser profiles, memory and history stay on your device. No telemetry'],
    them: ['no', 'Requires cloud data storage'],
  },
  {
    label: 'Talk to it from',
    us: ['yes', 'Desktop app, web dashboard, Slack, Telegram, Microsoft Teams, voice'],
    them: ['yes', 'Desktop app, iPhone, iPad and Android'],
  },
  {
    label: 'Keeps working with your laptop shut',
    us: ['partial', 'Yes, when it runs on an always-on Mac mini, PC or server'],
    them: ['yes', 'Yes, it lives in the cloud'],
  },
  {
    label: 'Price',
    us: ['yes', `${PRICING.trialDays} days free, then $${monthly.price}/mo or $${yearly.perMonth}/mo yearly, plus your Claude plan`],
    them: ['partial', 'Inside Cursor (from $20/mo) or SuperGrok (from $30/mo). Heavy users report limits even on $200–$300 plans'],
  },
];

const mark = {
  yes: { icon: 'check', cls: 'text-brand', sr: 'Yes' },
  no: { icon: 'x', cls: 'text-[rgb(240_82_91/0.8)]', sr: 'No' },
  partial: { icon: 'minus', cls: 'text-warn', sr: 'Partly' },
} as const;

const reasons = [
  {
    icon: 'cookie',
    title: 'Already signed in, everywhere',
    text: 'Grok Bot starts in an empty cloud browser. Godmode imports your Chrome profile, so your CRM, bank, ad accounts and admin panels are open on the first task.',
  },
  {
    icon: 'key-round',
    title: '2FA without you on standby',
    text: 'In Grok Bot you take over and type codes yourself. Godmode’s vault fills passwords and authenticator codes into the page, so a 06:00 job at six portals just runs.',
  },
  {
    icon: 'gauge',
    title: 'No weekly meter',
    text: 'Grok Bot’s allowance resets weekly and the number isn’t published. Godmode adds no cap of its own: your agents run on the Claude plan or API key you choose.',
  },
  {
    icon: 'mouse-pointer-click',
    title: 'Real computer use on your apps',
    text: 'Excel, Finder, a legacy ERP client, the vendor tool that has no API: Godmode drives the actual window in the background while you keep working.',
  },
  {
    icon: 'sparkles',
    title: 'Claude, not a mystery model',
    text: `Godmode thinks with ${SITE.model} through Anthropic’s own Claude Code, the agent developers already trust for long, careful work.`,
  },
  {
    icon: 'hard-drive',
    title: 'Your logins stay home',
    text: 'Cloud agents keep your signed-in sessions on the vendor’s computer. With Godmode, cookies, vault and memory never leave your machine.',
  },
];

const sameTask = {
  prompt: 'On the 1st of every month, download last month’s invoices from our 6 supplier portals, file them in Drive and send the totals to #finance.',
  them: [
    ['cloud', 'Opens a fresh browser on its cloud computer'],
    ['hand', 'Asks you to approve the login at portal 1 of 6'],
    ['smartphone', 'Waits while you type each 2FA code yourself'],
    ['clock', 'Next month: sessions expired, you are needed again'],
  ],
  us: [
    ['cookie', 'Continues your Chrome sessions on your computer'],
    ['key-round', 'Vault fills the 2 expired logins and their 2FA codes'],
    ['file-down', 'Downloads 23 invoices and files them in Drive'],
    ['send', 'Posts the totals to #finance. You were asleep'],
  ],
};

const steps = [
  ['download', 'Install Godmode', 'macOS, Windows or Linux. Sign in with your Claude plan or an Anthropic API key.'],
  ['import', 'Bring your sessions', 'Import your Chrome profile and your logins from Chrome, 1Password or Bitwarden. 2FA from a Google Authenticator QR screenshot.'],
  ['users', 'Recreate your Bots in one message', 'Tell the main agent what each Bot did (“a sales assistant that updates HubSpot after every call”). It creates the agent, its memory and its schedule.'],
];

const faqs = [
  {
    q: 'Is Godmode a good Grok Bot alternative?',
    a: `Yes, if you want an AI coworker that works on your own computer with the logins you already have. Both give you persistent agents with memory that use a browser and apps to finish real work. Grok Bot does it on a cloud computer with a model xAI picks for each task; Godmode's agent works on your device and thinks with ${SITE.model} on every task, with an encrypted vault for passwords and 2FA and no usage cap of its own.`,
  },
  {
    q: 'Is Godmode cheaper than Grok Bot?',
    a: `Godmode is $${monthly.price} a month, or $${yearly.perMonth} a month billed yearly, after a ${PRICING.trialDays}-day free trial, plus the Claude plan or API key you already have. Grok Bot comes inside Cursor plans (from $20 a month) or SuperGrok (from $30 a month) with a weekly allowance; heavy users report hitting limits even on $200–$300 plans. If you run agents every day, a predictable Godmode subscription plus Claude Max is usually the calmer bill.`,
  },
  {
    q: 'Doesn’t Grok Bot use Claude now?',
    a: `For some tasks. On October 7, 2026 xAI announced that Grok Bot will route each request to the model it judges best, including Claude Opus 5.5, while most simple requests go to a fast Grok 4.8. Godmode runs Claude on every task, on the Claude plan or API key you choose, so you always know which model did the work. The bigger difference is where the work happens: on your own computer with the logins you already have, and a vault that fills passwords and 2FA codes.`,
  },
  {
    q: 'Does Godmode use Grok?',
    a: `No. Godmode runs on Anthropic’s official Claude Code, so your agents think with ${SITE.model} and every newer Claude model as soon as your account has it.`,
  },
  {
    q: 'What happens to my logins in Grok Bot compared with Godmode?',
    a: 'Grok Bot can fill passwords from a shared 1Password vault after you approve each fill; for passkeys and 2FA codes you take over its cloud computer and type them yourself. The signed-in session then persists on that shared cloud computer. In Godmode, logins and 2FA secrets sit in an AES-256-GCM vault on your device and are typed straight into the page. The model only learns that a secret was filled, never its value.',
  },
  {
    q: 'Can Godmode keep working when my laptop is closed, like Grok Bot?',
    a: 'Not on the laptop itself, because Godmode works on your machine. For 24/7 agents, run the Godmode server on an always-on Mac mini, PC or home server and reach it from the web dashboard, Slack, Telegram or Teams.',
  },
  {
    q: 'Can I move my Grok Bots to Godmode?',
    a: 'Yes. Describe each Bot to Godmode’s main agent in a sentence (its job, the apps it uses, when it should run) and it builds the agent with instructions, memory and a schedule. Import your Chrome profile first and most of those apps are already signed in.',
  },
  {
    q: 'When is Grok Bot the better choice?',
    a: 'If you already pay for Cursor or SuperGrok, want xAI to pick the model for each task, need agents on your phone without any computer at home, or never want to run anything on your own hardware, Grok Bot is a fine pick. Godmode is for people who want the agent where their logins, files and apps already are.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Grok Bot alternative: Godmode vs Grok Bot (2026)"
  description={`Godmode vs Grok Bot, compared honestly: where the agent runs, who holds your logins and 2FA, usage limits, computer use and price. Godmode's agent works on your own computer, with ${SITE.model} on every task.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Nav home={false} />
  <main data-track-view="vs_grok_bot">
    <section class="relative overflow-hidden pt-36 pb-16 sm:pt-44 sm:pb-20">
      <div class="vs-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="container-x">
        <div class="max-w-[900px]">
          <p class="eyebrow" data-reveal><span class="n">vs</span> Godmode vs Grok Bot</p>
          <Words as="h1" text="Grok Bot rents you a computer. *Godmode works on yours.*" class="h-section mt-6 !text-[clamp(38px,6vw,76px)]" />
          <p class="lead mt-7 max-w-[660px]" data-reveal style="--d:200">
            Both give you AI teammates that click through websites and apps to finish real work. Grok Bot does it on a
            cloud computer you sign into from scratch. Godmode's agent does it on your own machine, already signed
            in, with {SITE.model} on every task and a vault that types your 2FA codes for it.
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row" data-reveal style="--d:320">
            <CheckoutButton plan="monthly" label={`Start ${PRICING.trialDays}-day free trial`} source="vs_grok_hero" size="lg" />
            <a href="#table" class="btn btn-ghost btn-lg" data-track="vs_grok_table">See the full comparison</a>
          </div>
          <ul class="mt-9 flex flex-wrap gap-2" data-reveal style="--d:420">
            {['Your device, not their cloud', 'Chrome sessions imported', '2FA filled for you', 'No weekly usage meter', `${SITE.model} computer use`].map((t) => (
              <li class="chip chip-brand"><Icon name="check" size={11} stroke={2.4} /> {t}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <section class="pb-20 sm:pb-28">
      <div class="container-x grid gap-3 md:grid-cols-2">
        <div class="card p-7 sm:p-9" data-reveal>
          <p class="flex items-center gap-2.5 text-[15px] font-medium"><Logo size={22} /> Pick Godmode if you want</p>
          <ul class="mt-6 space-y-3.5 text-[15px] leading-relaxed text-text-2">
            <li class="flex gap-3"><Icon name="check" size={17} stroke={2.2} class="mt-0.5 flex-none text-brand" />Agents that use the accounts you are already signed into</li>
            <li class="flex gap-3"><Icon name="check" size={17} stroke={2.2} class="mt-0.5 flex-none text-brand" />Scheduled jobs behind 2FA that finish without you</li>
            <li class="flex gap-3"><Icon name="check" size={17} stroke={2.2} class="mt-0.5 flex-none text-brand" />Computer use on your real desktop apps, not a cloud copy</li>
            <li class="flex gap-3"><Icon name="check" size={17} stroke={2.2} class="mt-0.5 flex-none text-brand" />Claude doing the thinking on every task, with no extra weekly cap</li>
            <li class="flex gap-3"><Icon name="check" size={17} stroke={2.2} class="mt-0.5 flex-none text-brand" />Logins, files and memory that never leave your machine</li>
          </ul>
        </div>
        <div class="card p-7 sm:p-9" data-reveal style="--d:80">
          <p class="flex items-center gap-2.5 text-[15px] font-medium text-text-2"><Icon name="cloud" size={20} class="text-muted" /> Grok Bot is fine if you want</p>
          <ul class="mt-6 space-y-3.5 text-[15px] leading-relaxed text-muted">
            <li class="flex gap-3"><Icon name="minus" size={17} stroke={2.2} class="mt-0.5 flex-none text-dim" />xAI picking the model for each task, mostly Grok</li>
            <li class="flex gap-3"><Icon name="minus" size={17} stroke={2.2} class="mt-0.5 flex-none text-dim" />Agents without any computer of your own switched on</li>
            <li class="flex gap-3"><Icon name="minus" size={17} stroke={2.2} class="mt-0.5 flex-none text-dim" />Something bundled into a Cursor or SuperGrok plan you already pay for</li>
            <li class="flex gap-3"><Icon name="minus" size={17} stroke={2.2} class="mt-0.5 flex-none text-dim" />To sign in and type 2FA codes yourself whenever a session expires</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="pb-20 sm:pb-28">
      <div class="container-x">
        <div class="max-w-[760px]">
          <p class="eyebrow" data-reveal><span class="n">01</span> Same task, two agents</p>
          <Words text="One sentence. *Very different mornings.*" class="h-section mt-6" />
        </div>
        <div class="card mt-12 overflow-hidden" data-reveal style="--d:100">
          <div class="border-b border-line p-6 sm:p-8">
            <div class="prompt-box px-5 py-4 text-[16px] leading-relaxed text-text sm:text-[18px]">“{sameTask.prompt}”</div>
          </div>
          <div class="grid md:grid-cols-2">
            <div class="border-b border-line p-6 sm:p-8 md:border-r md:border-b-0">
              <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.12em] text-dim uppercase"><Icon name="cloud" size={13} /> Grok Bot</p>
              <ol class="mt-5 space-y-2">
                {sameTask.them.map(([icon, text]) => (
                  <li class="flex items-center gap-3 rounded-xl px-3.5 py-3 text-[14.5px] text-muted ring-1 ring-line">
                    <Icon name={icon} size={15} class="flex-none text-dim" /> {text}
                  </li>
                ))}
              </ol>
              <p class="mt-5 text-[13px] text-dim">You: needed 6 times, every month.</p>
            </div>
            <div class="vs-us p-6 sm:p-8">
              <p class="flex items-center gap-2 font-mono text-[11px] tracking-[0.12em] text-brand uppercase"><Logo size={16} /> Godmode</p>
              <ol class="mt-5 space-y-2">
                {sameTask.us.map(([icon, text]) => (
                  <li class="flex items-center gap-3 rounded-xl bg-brand-soft px-3.5 py-3 text-[14.5px] text-text ring-1 ring-[var(--brand-line)]">
                    <Icon name={icon} size={15} class="flex-none text-brand" /> {text}
                  </li>
                ))}
              </ol>
              <p class="mt-5 text-[13px] text-brand">You: needed 0 times. Asks only before anything risky.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="table" class="scroll-mt-24 pb-20 sm:pb-28">
      <div class="container-x">
        <div class="max-w-[760px]">
          <p class="eyebrow" data-reveal><span class="n">02</span> Side by side</p>
          <Words text="Godmode vs Grok Bot, *feature by feature.*" class="h-section mt-6" />
        </div>
        <p class="mt-10 flex items-center justify-end gap-1.5 text-[12px] text-dim md:hidden">Swipe to compare <Icon name="arrow-right" size={12} /></p>
        <div class="card mt-3 overflow-hidden md:mt-12" data-reveal style="--d:100">
          <div class="overflow-x-auto">
            <table class="compare w-full min-w-[720px] border-collapse text-left">
              <caption class="sr-only">Godmode compared with Grok Bot</caption>
              <thead>
                <tr>
                  <th scope="col" class="w-[24%]"><span class="sr-only">Feature</span></th>
                  <th scope="col" class="col-head is-us w-[38%]"><span class="flex items-center gap-2"><Logo size={20} /> Godmode</span></th>
                  <th scope="col" class="col-head w-[38%]">Grok Bot</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    {[r.us, r.them].map(([kind, note], i) => (
                      <td class:list={[i === 0 && 'is-us']}>
                        <span class="flex items-start gap-2.5">
                          <Icon name={mark[kind].icon} size={16} stroke={2.2} class:list={['mt-0.5 flex-none', mark[kind].cls]} />
                          <span class="sr-only">{mark[kind].sr}.</span>
                          <span class:list={['text-[13.5px] leading-snug', i === 0 ? 'text-text-2' : 'text-muted']}>{note}</span>
                        </span>
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        <p class="mt-4 text-[12px] leading-relaxed text-dim" data-reveal>
          Grok Bot facts from the <a href="https://docs.x.ai/grok-bot/overview" rel="noopener nofollow" class="underline decoration-line-3 underline-offset-2 hover:text-text">xAI</a> and
          <a href="https://cursor.com/docs/grok-bot" rel="noopener nofollow" class="underline decoration-line-3 underline-offset-2 hover:text-text">Cursor</a> docs, plan pages
          and press coverage as of {checked}. Grok Bot is in beta and changes quickly. Spotted something out of date?
          <a href={`mailto:${SITE.email}`} class="underline decoration-line-3 underline-offset-2 hover:text-text">Tell us</a> and we’ll fix it.
          Grok is a trademark of its owner; Godmode is not affiliated with xAI or Cursor.
        </p>
      </div>
    </section>

    <section class="pb-20 sm:pb-28">
      <div class="container-x">
        <div class="max-w-[760px]">
          <p class="eyebrow" data-reveal><span class="n">03</span> Why people switch</p>
          <Words text="Six reasons Godmode *gets more done.*" class="h-section mt-6" />
        </div>
        <div class="mt-12 grid gap-3 md:grid-cols-2 lg:grid-cols-3">
          {reasons.map((r, i) => (
            <article class="card p-7" data-reveal style={`--d:${(i % 3) * 70}`}>
              <span class="grid size-10 place-items-center rounded-xl bg-brand-soft text-brand ring-1 ring-[var(--brand-line)]">
                <Icon name={r.icon} size={18} />
              </span>
              <h3 class="h-card mt-5">{r.title}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{r.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <ComputerUse eyebrow="04" />

    <section class="py-20 sm:py-28">
      <div class="container-x">
        <div class="max-w-[760px]">
          <p class="eyebrow" data-reveal><span class="n">05</span> Switching</p>
          <Words text="From Grok Bot to Godmode *in ten minutes.*" class="h-section mt-6" />
        </div>
        <ol class="mt-12 grid gap-3 md:grid-cols-3">
          {steps.map(([icon, title, text], i) => (
            <li class="card p-7" data-reveal style={`--d:${i * 80}`}>
              <div class="flex items-center justify-between">
                <span class="grid size-10 place-items-center rounded-xl bg-[rgb(255_250_240/0.04)] text-text-2 ring-1 ring-line"><Icon name={icon} size={18} /></span>
                <span class="font-mono text-[12px] text-dim">0{i + 1}</span>
              </div>
              <h3 class="h-card mt-5">{title}</h3>
              <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{text}</p>
            </li>
          ))}
        </ol>
        <p class="mt-6 text-[15px] text-muted" data-reveal>
          Need ideas for your first agents? Browse <a href="/use-cases" class="text-text underline decoration-line-3 underline-offset-3 hover:decoration-brand">60 use cases</a>
          or the <a href="/playbook" class="text-text underline decoration-line-3 underline-offset-3 hover:decoration-brand">playbook</a>.
        </p>
      </div>
    </section>

    <section class="pb-20 sm:pb-28">
      <div class="container-x grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="lg:sticky lg:top-28 lg:self-start">
          <p class="eyebrow" data-reveal><span class="n">06</span> FAQ</p>
          <Words text="Godmode or Grok Bot? *Straight answers.*" class="h-section mt-6 !text-[clamp(30px,4vw,48px)]" />
        </div>
        <div class="divide-y divide-line border-y border-line">
          {faqs.map((f, i) => (
            <details class="faq group" data-faq={`grok_${i}`} data-reveal style={`--d:${Math.min(i, 6) * 40}`}>
              <summary class="flex cursor-pointer items-center justify-between gap-6 py-6 text-[17px] font-medium tracking-[-0.015em] transition-colors hover:text-white">
                {f.q}
                <span class="plus grid size-8 flex-none place-items-center rounded-full ring-1 ring-line-2 transition-colors group-hover:ring-line-3" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 12 12"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
                </span>
              </summary>
              <p class="max-w-[640px] pb-7 text-[15px] leading-[1.7] text-muted">{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="pb-8">
      <div class="container-x">
        <div class="card p-8 text-center sm:p-14" data-reveal>
          <h2 class="mx-auto max-w-[18ch] text-[clamp(28px,4vw,48px)] leading-[1.05] font-semibold tracking-[-0.04em]">Keep your logins. Lose the busywork.</h2>
          <p class="mx-auto mt-4 max-w-[540px] text-muted">
            {PRICING.trialDays} days free, then ${monthly.price}/month or ${yearly.perMonth}/month billed yearly. $0 today, cancel anytime.
          </p>
          <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
            <CheckoutButton plan="monthly" label={`Start ${PRICING.trialDays}-day free trial`} source="vs_grok_final" size="lg" />
            <CheckoutButton plan="yearly" label={`Or yearly — $${yearly.perMonth}/mo, save ${yearlySavings}%`} source="vs_grok_final" variant="ghost" size="lg" />
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .vs-glow {
    background:
      radial-gradient(60% 50% at 18% 0%, rgb(47 214 144 / 0.14), transparent 70%),
      radial-gradient(40% 40% at 90% 10%, rgb(255 250 240 / 0.05), transparent 70%);
  }
  .vs-us { background: rgb(47 214 144 / 0.03); }
</style>
