---
import Base from '@/layouts/Base.astro';
import Logo from '@/components/ui/Logo.astro';
import Icon from '@/components/ui/Icon.astro';
import { FOUNDING, isPlan, PRICING, SITE, type Plan } from '@/config/site';
import { stripe } from '@/lib/stripe';
import { syncSubscription, upsertFromSession } from '@/lib/db';
import { ORDER_COOKIE, publicId, sign, verify } from '@/lib/signed';
import { allowed } from '@/lib/limit';
import type Stripe from 'stripe';

export const prerender = false;

const SESSION_ID = /^cs_(test|live)_[A-Za-z0-9]+$/;
const DAY = 86400;

// Stripe sends buyers here with ?session_id=… . A Checkout Session ID never expires, so it must not act as a
// password forever: exchange it (within a day of the purchase) for a signed, HttpOnly cookie and continue on
// the clean URL — which is also what the X pixel and browser history see.
const fromQuery = Astro.url.searchParams.get('session_id') ?? '';
if (SESSION_ID.test(fromQuery)) {
  let fresh = false;
  if (await allowed('CHECKOUT_LIMIT', Astro.request)) {
    try {
      const s = await stripe().checkout.sessions.retrieve(fromQuery);
      fresh = s.status === 'complete' && Boolean(s.metadata?.license_key) && Date.now() / 1000 - s.created < DAY;
    } catch (e) {
      console.error('success page lookup failed', e);
    }
  }
  if (fresh) {
    Astro.cookies.set(ORDER_COOKIE, await sign(fromQuery, 30 * DAY), {
      httpOnly: true,
      secure: Astro.url.protocol === 'https:',
      sameSite: 'lax',
      path: '/',
      maxAge: 30 * DAY,
    });
  }
  const hasCookie = fresh || Boolean(await verify(Astro.cookies.get(ORDER_COOKIE)?.value));
  return Astro.redirect(hasCookie ? '/checkout/success' : '/checkout/success?expired=1', 303);
}

const id = await verify(Astro.cookies.get(ORDER_COOKIE)?.value);
let session: Stripe.Checkout.Session | null = null;
let state: 'paid' | 'processing' | 'invalid' | 'expired' = Astro.url.searchParams.has('expired') ? 'expired' : 'invalid';

if (id) {
  try {
    session = await stripe().checkout.sessions.retrieve(id, { expand: ['subscription'] });
    if (session.status === 'complete' && session.metadata?.license_key) {
      const paid = session.payment_status === 'paid' || session.payment_status === 'no_payment_required';
      state = paid ? 'paid' : 'processing';
      // Same idempotent writes as the webhook, so the license works even if the webhook is late.
      await upsertFromSession(session, paid ? 'paid' : 'pending').catch((e) => console.error(e));
      if (typeof session.subscription === 'object' && session.subscription) {
        await syncSubscription(session.subscription).catch((e) => console.error(e));
      }
    }
  } catch (e) {
    console.error('success page lookup failed', e);
  }
}

const metaPlan = session?.metadata?.plan;
const plan: Plan = isPlan(metaPlan) ? metaPlan : 'monthly';
const licenseKey = session?.metadata?.license_key ?? '';
const email = session?.customer_details?.email ?? '';
const sub = session && typeof session.subscription === 'object' ? session.subscription : null;
const trialEnd = sub?.status === 'trialing' && sub.trial_end ? sub.trial_end * 1000 : null;
const trialEndText = trialEnd
  ? new Date(trialEnd).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : '';
const offer = PRICING.plans[plan];
const purchase =
  state === 'paid' && session
    ? {
        id: await publicId(session.id),
        // A started trial has collected nothing, so it reports no value.
        value: trialEnd ? 0 : (session.amount_total ?? 0) / 100,
        currency: (session.currency ?? 'usd').toUpperCase(),
        plan: trialEnd ? `${plan}_trial` : plan,
      }
    : null;

// The handoff link for buyers on a phone: opens the download page on their computer with the key filled in.
const handoffUrl = licenseKey ? `${Astro.url.origin}/download?key=${licenseKey}` : '';
const mailBody = `Your Godmode license key: ${licenseKey}\n\nDownload Godmode on your Mac or PC (your key is already filled in):\n${handoffUrl}\n`;
const mailto = `mailto:${encodeURIComponent(email)}?subject=${encodeURIComponent('Your Godmode license')}&body=${encodeURIComponent(mailBody)}`;

const founding = session?.metadata?.founding === '1';
const setupBody = `License: ${licenseKey}\n\nMy time zone:\nTimes that work for me this week:\n\n3 things I want Godmode to do for me:\n1.\n2.\n3.\n`;
const setupUrl =
  FOUNDING.bookingUrl ||
  `mailto:${SITE.email}?subject=${encodeURIComponent('Founding setup call')}&body=${encodeURIComponent(setupBody)}`;

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'no-referrer');

const steps = [
  { icon: 'download', title: 'Install Godmode', text: 'Download the app below and open it. Onboarding installs Claude Code and everything else it needs.' },
  { icon: 'sparkles', title: 'Connect Claude', text: 'Sign in with your Claude Pro or Max plan, or paste an Anthropic API key.' },
  { icon: 'key-round', title: 'Give it access', text: 'Import your Chrome profile, your passwords and your 2FA codes (Vault → Import).' },
  { icon: 'send', title: 'Hand over your first task', text: '“Log into … and …” — then watch it work, or go get a coffee.' },
];
---

<Base title="Welcome to Godmode" noindex>
  <main class="relative min-h-dvh overflow-hidden pt-16 pb-24">
    <div class="final-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-x max-w-[880px]">
      <a href="/" class="inline-flex items-center gap-2.5" aria-label="Godmode home">
        <Logo size={28} /><span class="font-semibold tracking-[-0.03em]">Godmode</span>
      </a>

      {
        state === 'invalid' && (
          <div class="mt-20 text-center">
            <h1 class="h-section">We couldn’t find that purchase.</h1>
            <p class="lead mx-auto mt-5 max-w-[520px]">
              If you just paid, check your email for the receipt — or write to{' '}
              <a class="text-text underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll sort it out right away.
            </p>
            <a href="/" class="btn btn-ghost mt-8">Back to the homepage</a>
          </div>
        )
      }

      {
        state === 'expired' && (
          <div class="mt-20 text-center">
            <h1 class="h-section">This welcome link has expired.</h1>
            <p class="lead mx-auto mt-5 max-w-[540px]">
              For your security, purchase links only work for a day. Your license key is on your invoice and in the billing
              portal — or email <a class="text-text underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll resend it.
            </p>
            <a href="/" class="btn btn-ghost mt-8">Back to the homepage</a>
          </div>
        )
      }

      {
        state === 'processing' && (
          <div class="mt-20 text-center">
            <span class="chip mx-auto"><span class="live-dot !size-1.5" /> Payment processing</span>
            <h1 class="h-section mt-6">Almost there.</h1>
            <p class="lead mx-auto mt-5 max-w-[540px]">
              Your bank is confirming the payment. As soon as it clears you’ll get an email{email && ` at ${email}`} with
              your receipt — your license key is below and activates automatically.
            </p>
            {licenseKey && <p class="mt-8 font-mono text-[18px] tracking-wider">{licenseKey}</p>}
          </div>
        )
      }

      {
        state === 'paid' && (
          <>
            <div class="mt-16 text-center sm:mt-24">
              <div class="success-check mx-auto grid size-16 place-items-center rounded-full bg-brand-soft text-brand ring-1 ring-[rgb(47_214_144/0.35)]" data-reveal="scale">
                <Icon name="check" size={30} stroke={2.4} />
              </div>
              <h1 class="h-display text-grad mx-auto mt-8 !text-[clamp(40px,7vw,80px)]" data-reveal style="--d:100">
                Welcome to <span class="serif">Godmode.</span>
              </h1>
              <p class="lead mx-auto mt-5 max-w-[580px]" data-reveal style="--d:200">
                {trialEnd ? (
                  <>
                    Your {PRICING.trialDays}-day trial is running. You won’t be charged until{' '}
                    <time class="text-text" datetime={new Date(trialEnd).toISOString()} data-local-date>{trialEndText}</time>{plan === 'yearly' ? `, then $${offer.price} for the year` : `, then $${offer.price} a month`}.
                    Cancel anytime in the billing portal.
                  </>
                ) : plan === 'yearly' ? (
                  <>Your yearly Godmode Pro plan is active for the next 12 months. A receipt is on its way{email ? ` to ${email}` : ''}.</>
                ) : (
                  <>Your Godmode Pro subscription is active. A receipt is on its way{email ? ` to ${email}` : ''}.</>
                )}
              </p>
            </div>

            {founding && (
              <div class="card mt-12 p-6 sm:p-8" data-reveal style="--d:260">
                <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                  <div class="flex items-start gap-4">
                    <span class="grid size-11 flex-none place-items-center rounded-xl bg-brand-soft text-brand">
                      <Icon name="calendar-check" size={20} />
                    </span>
                    <div>
                      <p class="font-mono text-[11px] tracking-[0.12em] text-brand uppercase">Founding member</p>
                      <p class="h-card mt-1">Book your {FOUNDING.setupMinutes}-minute setup call</p>
                      <p class="mt-1.5 max-w-[460px] text-[14px] leading-relaxed text-muted">
                        Tell us the {FOUNDING.setupAutomations} things you want off your plate. We build them with you on
                        the call, and your founders group invite follows right after.
                      </p>
                    </div>
                  </div>
                  <a href={setupUrl} class="btn btn-primary flex-none" data-track="founding_book" target={FOUNDING.bookingUrl ? '_blank' : undefined} rel="noopener">
                    Book my call <Icon name="arrow-right" size={16} class="arrow" />
                  </a>
                </div>
                <ul class="mt-6 grid gap-2 border-t border-line pt-5 text-[13px] text-text-2 sm:grid-cols-3">
                  <li class="flex items-start gap-2"><Icon name="check" size={14} class="mt-0.5 flex-none text-brand" /> Price locked for as long as you stay</li>
                  <li class="flex items-start gap-2"><Icon name="check" size={14} class="mt-0.5 flex-none text-brand" /> Running in {FOUNDING.runningHours} hours, or we set it up with you</li>
                  <li class="flex items-start gap-2"><Icon name="check" size={14} class="mt-0.5 flex-none text-brand" /> {FOUNDING.outcomeHours} hours back in {FOUNDING.outcomeDays} days, or full refund</li>
                </ul>
              </div>
            )}

            <div class="mt-12 flex flex-col gap-3">
              <div class="card p-6 sm:p-8" data-reveal style="--d:300">
                <p class="font-mono text-[11px] tracking-[0.12em] text-dim uppercase">Your license key</p>
                <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
                  <code class="flex-1 rounded-xl bg-[rgb(0_0_0/0.35)] px-4 py-3.5 font-mono text-[16px] tracking-[0.04em] break-all text-text ring-1 ring-line-2 sm:text-[19px] sm:tracking-[0.06em]">
                    {licenseKey}
                  </code>
                  <button type="button" class="btn btn-ghost" data-copy={licenseKey}>
                    <Icon name="copy" size={15} /> <span data-copy-label>Copy</span>
                  </button>
                </div>
                <p class="mt-3 text-[13px] text-muted">
                  Keep it somewhere safe — it’s also shown in your billing portal.
                </p>
              </div>

              <div class="send-card card order-first p-6 sm:order-last sm:p-8" data-send data-reveal style="--d:250">
                <div class="flex items-start gap-4">
                  <span class="grid size-11 flex-none place-items-center rounded-xl bg-brand-soft text-brand">
                    <Icon name="laptop" size={20} />
                  </span>
                  <div>
                    <p class="h-card">
                      <span class="sm:hidden">Now send it to your computer</span>
                      <span class="hidden sm:inline">Installing on another computer?</span>
                    </p>
                    <p class="mt-1.5 text-[14px] leading-relaxed text-muted">
                      Godmode runs on your Mac or PC. Send yourself this link — it opens the download with your key filled in.
                    </p>
                  </div>
                </div>
                <div class="mt-5 flex flex-col gap-2 sm:flex-row">
                  <button type="button" class="btn btn-primary sm:flex-1" data-share={handoffUrl} data-track="handoff_share" hidden>
                    <Icon name="share" size={16} /> Send to my computer
                  </button>
                  <a href={mailto} class="btn btn-ghost sm:flex-1" data-mail-handoff data-track="handoff_email">
                    <Icon name="mail" size={16} /> Email it to me
                  </a>
                  <button type="button" class="btn btn-ghost sm:flex-1" data-copy={handoffUrl} data-track="handoff_copy">
                    <Icon name="link" size={15} /> <span data-copy-label>Copy link</span>
                  </button>
                </div>
              </div>

              <div data-reveal style="--d:350">
                <div class="grid gap-3 sm:grid-cols-3">
                  <a href="/download/mac" class="card flex items-center gap-4 p-5" data-track="download_mac">
                    <Icon name="apple" size={22} />
                    <span><b class="block text-[15px] font-medium">macOS</b><span class="text-[12.5px] text-muted">Apple silicon</span></span>
                  </a>
                  <a href="/download/windows" class="card flex items-center gap-4 p-5" data-track="download_windows">
                    <Icon name="monitor" size={22} />
                    <span><b class="block text-[15px] font-medium">Windows</b><span class="text-[12.5px] text-muted">.msi / .exe</span></span>
                  </a>
                  <a href="/download/linux" class="card flex items-center gap-4 p-5" data-track="download_linux">
                    <Icon name="terminal" size={22} />
                    <span><b class="block text-[15px] font-medium">Linux</b><span class="text-[12.5px] text-muted">AppImage</span></span>
                  </a>
                </div>
                <p class="mt-3 text-center text-[12.5px] text-dim">
                  Also: <a class="hover:text-text underline decoration-line-2 underline-offset-2" href="/download/mac-intel">macOS Intel</a> ·
                  <a class="hover:text-text underline decoration-line-2 underline-offset-2" href="/download/windows-msi">Windows MSI</a> ·
                  <a class="hover:text-text underline decoration-line-2 underline-offset-2" href="/download/linux-deb">.deb</a> ·
                  <a class="hover:text-text underline decoration-line-2 underline-offset-2" href="/download/linux-rpm">.rpm</a> ·
                  <a class="hover:text-text underline decoration-line-2 underline-offset-2" href="/download">headless server & all builds</a>
                </p>
              </div>
            </div>

            <ol class="mt-12 grid gap-3 sm:grid-cols-2" data-reveal style="--d:400">
              {steps.map((s, i) => (
                <li class="card p-6">
                  <div class="flex items-center gap-3">
                    <span class="grid size-8 place-items-center rounded-full font-mono text-[13px] ring-1 ring-line-2">{i + 1}</span>
                    <Icon name={s.icon} size={16} class="text-brand" />
                  </div>
                  <p class="mt-4 text-[16px] font-medium tracking-[-0.015em]">{s.title}</p>
                  <p class="mt-1.5 text-[14px] leading-relaxed text-muted">{s.text}</p>
                </li>
              ))}
            </ol>

            <div class="mt-12 flex flex-col items-center justify-between gap-4 rounded-2xl p-6 ring-1 ring-line sm:flex-row">
              <p class="text-[14px] text-muted">
                Questions or stuck? Email <a class="text-text underline decoration-line-3 underline-offset-2" href={`mailto:${SITE.email}`}>{SITE.email}</a> —
                you’ll hear back from a human. {PRICING.guaranteeDays}-day money-back guarantee, always.
              </p>
              {session?.customer && (
                <a href="/api/portal" class="btn btn-ghost btn-sm flex-none">
                  <Icon name="receipt-text" size={14} /> {trialEnd ? 'Manage trial & billing' : 'Billing & invoices'}
                </a>
              )}
            </div>
          </>
        )
      }
    </div>
  </main>

  {
    purchase && (
      <script is:inline define:vars={{ purchase }}>
        window.__gmPurchase = purchase;
      </script>
    )
  }
  <script>
    import { consent, track, xEvent } from '@/scripts/analytics';

    document.querySelectorAll<HTMLTimeElement>('time[data-local-date]').forEach((t) => {
      const d = new Date(t.dateTime);
      if (!Number.isNaN(d.getTime())) t.textContent = d.toLocaleDateString(undefined, { month: 'long', day: 'numeric', year: 'numeric' });
    });

    const share = document.querySelector<HTMLButtonElement>('[data-share]');
    if (share && typeof navigator.share === 'function') {
      share.hidden = false;
      share.addEventListener('click', () => {
        navigator
          .share({ title: 'Godmode', text: 'Download Godmode (license key included)', url: share.dataset.share })
          .catch(() => {});
      });
    } else {
      // Without a share sheet, email is the most direct way to get the link to the computer.
      document.querySelector('[data-mail-handoff]')?.classList.replace('btn-ghost', 'btn-primary');
    }

    type Purchase = { id: string; value: number; currency: string; plan: string };
    const p = (window as unknown as { __gmPurchase?: Purchase }).__gmPurchase;
    const once = (key: string) => {
      try {
        if (sessionStorage.getItem(key) === '1') return false;
        sessionStorage.setItem(key, '1');
      } catch {
        /* ignore */
      }
      return true;
    };
    if (p) {
      track('purchase_view', p.plan);
      // The X conversion needs marketing consent — fire it now, or as soon as the visitor accepts.
      const fireX = () => {
        if (consent() !== 'all' || !once(`gm.purchase.x.${p.id}`)) return;
        xEvent('purchase', {
          value: p.value,
          currency: p.currency,
          conversion_id: p.id,
          contents: [{ content_id: p.plan, content_name: `Godmode ${p.plan}`, content_price: p.value, num_items: 1 }],
        });
      };
      fireX();
      window.addEventListener('gm:consent', fireX, { once: true });
    }
  </script>
</Base>
