---
// Where Stripe sends people who leave checkout. Answer the likely reason and point to the free trial.
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import CheckoutButton from '@/components/ui/CheckoutButton.astro';
import { PRICING, SITE, yearlySavings } from '@/config/site';

const { monthly, yearly } = PRICING.plans;
const reasons = [
  {
    icon: 'wallet',
    q: 'I don’t want to pay before I’ve tried it.',
    a: `You don’t have to. Start the ${PRICING.trialDays}-day free trial: nothing is charged today, and if you cancel before day ${PRICING.trialDays} you pay nothing. After that it’s $${monthly.price} a month, or $${yearly.perMonth} a month billed yearly.`,
  },
  {
    icon: 'shield-question',
    q: 'Not sure it will work for my tasks.',
    a: `That’s what the trial is for. Hand it your hardest workflow this week. And if you only notice after your first payment, a ${PRICING.guaranteeDays}-day money-back guarantee still has you covered.`,
  },
  {
    icon: 'lock-keyhole',
    q: 'Worried about my passwords.',
    a: 'They stay encrypted on your device. In the browser, Godmode types them into the page itself — the AI never sees them.',
  },
];
---

<Base title="Checkout canceled" noindex>
  <Nav home={false} />
  <main class="relative pt-36 pb-24">
    <div class="container-x max-w-[900px]">
      <div id="checkout-error" hidden class="mb-10 flex items-start gap-3 rounded-2xl p-4 text-[14px] ring-1 ring-[rgb(240_82_91/0.35)]" style="background: rgb(240 82 91 / 0.06)">
        <Icon name="triangle-alert" size={18} class="mt-0.5 flex-none text-danger" />
        <p class="text-text-2">
          Checkout is briefly unavailable — sorry about that. Please try again in a minute, or email
          <a class="text-text underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll send you a payment link.
        </p>
      </div>

      <p class="eyebrow"><span class="n">●</span> No charge was made</p>
      <h1 class="h-section mt-5 max-w-[16ch]">Not sure yet? <span class="serif text-muted">Try it free for {PRICING.trialDays} days.</span></h1>
      <p class="lead mt-5 max-w-[560px]">No charge today, cancel anytime before day {PRICING.trialDays}. Here’s what usually holds people back — and why it shouldn’t.</p>

      <div class="mt-12 grid gap-3">
        {
          reasons.map((r, i) => (
            <div class="card flex items-start gap-5 p-6 sm:p-7" data-reveal style={`--d:${i * 80}`}>
              <span class="grid size-10 flex-none place-items-center rounded-xl bg-brand-soft text-brand">
                <Icon name={r.icon} size={18} />
              </span>
              <div>
                <p class="text-[17px] font-medium tracking-[-0.015em]">{r.q}</p>
                <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{r.a}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <CheckoutButton plan="monthly" label={`Start ${PRICING.trialDays}-day free trial`} source="recovery" size="lg" />
        <CheckoutButton plan="yearly" label={`Or yearly — $${yearly.perMonth}/mo, save ${yearlySavings}%`} source="recovery" variant="ghost" size="lg" />
      </div>
      <form data-remind class="lead-form card mt-10 p-6 sm:p-7">
        <p class="text-[17px] font-medium tracking-[-0.015em]">Not today? Get this checkout by email.</p>
        <p class="mt-1.5 text-[15px] leading-relaxed text-muted">One email in about a day with a link straight back to it. Nothing else.</p>
        <div class="mt-5 flex flex-col gap-2 sm:flex-row">
          <label class="sr-only" for="remind-email">Email</label>
          <input
            id="remind-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="h-[50px] flex-1 rounded-full bg-[rgb(255_250_240/0.04)] px-5 text-[15px] text-text ring-1 ring-line-2 outline-none placeholder:text-dim focus:ring-brand"
          />
          <button type="submit" class="btn btn-ghost !h-[50px]">
            <span class="btn-label">Email me the link</span>
            <span class="btn-spinner" aria-hidden="true"></span>
          </button>
        </div>
        <label class="mt-4 flex items-start gap-2.5 text-[13px] leading-relaxed text-muted">
          <input name="consent" type="checkbox" required class="mt-[3px] size-4 flex-none accent-brand" />
          <span>
            Yes, Codext GmbH may send me this one reminder about my Godmode checkout. Unsubscribe anytime.
            <a href="/legal/privacy" class="underline decoration-line-3 underline-offset-2">Privacy</a>
          </span>
        </label>
        <p data-status role="status" class="mt-3 min-h-[20px] text-[13px] text-muted"></p>
      </form>

      <p class="mt-6 text-[14px] text-muted">
        Have a question first? <a class="text-text underline decoration-line-3 underline-offset-2" href={`mailto:${SITE.email}?subject=Question%20about%20Godmode`}>Ask the founder directly</a>.
      </p>
    </div>
  </main>
  <Footer />
  <script>
    if (new URLSearchParams(location.search).get('error')) {
      document.getElementById('checkout-error')?.removeAttribute('hidden');
    }
    const remind = document.querySelector<HTMLFormElement>('form[data-remind]');
    remind?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(remind);
      const status = remind.querySelector<HTMLElement>('[data-status]');
      const btn = remind.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (btn) btn.dataset.loading = 'true';
      try {
        const res = await fetch('/api/remind', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email: data.get('email'), consent: data.get('consent') === 'on' }),
        });
        const body = (await res.json().catch(() => ({}))) as { error?: string };
        if (res.ok) {
          remind.classList.add('is-done');
          if (status) status.textContent = 'Done. Look out for an email from Daniel tomorrow.';
        } else if (status) {
          status.textContent =
            body.error === 'no_checkout'
              ? 'This checkout can’t be found any more. Start it again above, it only takes a minute.'
              : 'That didn’t work. Please check the address and try again.';
        }
      } catch {
        if (status) status.textContent = 'That didn’t work. Please check the address and try again.';
      } finally {
        if (btn) delete btn.dataset.loading;
      }
    });
  </script>
</Base>
