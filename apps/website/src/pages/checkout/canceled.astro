---
// Where Stripe sends people who leave checkout. Answer the likely reason and point to the free trial.
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import CheckoutButton from '@/components/ui/CheckoutButton.astro';
import { PRICING, SITE } from '@/config/site';

const { monthly, yearly, lifetime } = PRICING.plans;
const reasons = [
  {
    icon: 'wallet',
    q: 'I don’t want to pay before I’ve tried it.',
    a: `You don’t have to. Start the ${PRICING.trialDays}-day free trial: nothing is charged today, and if you cancel before day ${PRICING.trialDays} you pay nothing. After that it’s $${monthly.price} a month, or $${yearly.perMonth} a month billed yearly.`,
  },
  {
    icon: 'shield-question',
    q: 'Not sure it will work for my tasks.',
    a: `That’s what the trial is for. Hand it your hardest workflow this week. And if you only notice after your first payment, a ${PRICING.guaranteeDays}-day money-back guarantee still has you covered.`,
  },
  {
    icon: 'lock-keyhole',
    q: 'Worried about my passwords.',
    a: 'They stay encrypted on your device. In the browser, Godmode types them into the page itself — the AI never sees them.',
  },
];
---

<Base title="Checkout canceled" noindex>
  <Nav home={false} />
  <main class="relative pt-36 pb-24">
    <div class="container-x max-w-[900px]">
      <div id="checkout-error" hidden class="mb-10 flex items-start gap-3 rounded-2xl p-4 text-[14px] ring-1 ring-[rgb(240_82_91/0.35)]" style="background: rgb(240 82 91 / 0.06)">
        <Icon name="triangle-alert" size={18} class="mt-0.5 flex-none text-danger" />
        <p class="text-text-2">
          Checkout is briefly unavailable — sorry about that. Please try again in a minute, or email
          <a class="text-text underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> and we’ll send you a payment link.
        </p>
      </div>

      <p class="eyebrow"><span class="n">●</span> No charge was made</p>
      <h1 class="h-section mt-5 max-w-[16ch]">Not sure yet? <span class="serif text-muted">Try it free for {PRICING.trialDays} days.</span></h1>
      <p class="lead mt-5 max-w-[560px]">No charge today, cancel anytime before day {PRICING.trialDays}. Here’s what usually holds people back — and why it shouldn’t.</p>

      <div class="mt-12 grid gap-3">
        {
          reasons.map((r, i) => (
            <div class="card flex items-start gap-5 p-6 sm:p-7" data-reveal style={`--d:${i * 80}`}>
              <span class="grid size-10 flex-none place-items-center rounded-xl bg-brand-soft text-brand">
                <Icon name={r.icon} size={18} />
              </span>
              <div>
                <p class="text-[17px] font-medium tracking-[-0.015em]">{r.q}</p>
                <p class="mt-1.5 text-[15px] leading-relaxed text-muted">{r.a}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <CheckoutButton plan="monthly" label={`Start ${PRICING.trialDays}-day free trial`} source="recovery" size="lg" />
        <CheckoutButton plan="lifetime" label={`Founder Lifetime — $${lifetime.price}`} source="recovery" variant="ghost" size="lg" />
      </div>
      <p class="mt-6 text-[14px] text-muted">
        Have a question first? <a class="text-text underline decoration-line-3 underline-offset-2" href={`mailto:${SITE.email}?subject=Question%20about%20Godmode`}>Ask the founder directly</a>.
      </p>
    </div>
  </main>
  <Footer />
  <script>
    if (new URLSearchParams(location.search).get('error')) {
      document.getElementById('checkout-error')?.removeAttribute('hidden');
    }
  </script>
</Base>
