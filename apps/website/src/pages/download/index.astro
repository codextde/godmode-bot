---
import Base from '@/layouts/Base.astro';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import Icon from '@/components/ui/Icon.astro';
import { PLATFORMS } from '@/lib/releases';
import { isLicenseKey } from '@/lib/license';
import { SITE } from '@/config/site';
import { keyFromCookie, setKeyCookie } from '@/lib/signed';

export const prerender = false;

// ?key=GM-… arrives from the welcome page's "send to my computer" link. Move it into a cookie and reload the clean
// URL before anything renders, so the key never sits in the address bar, history, analytics or the ad pixel.
if (Astro.url.searchParams.has('key')) {
  await setKeyCookie(Astro.cookies, Astro.url.searchParams.get('key') ?? '', Astro.url.protocol === 'https:');
  const clean = new URLSearchParams(Astro.url.searchParams);
  clean.delete('key');
  Astro.response.headers.set('cache-control', 'no-store');
  return Astro.redirect(clean.size ? `/download?${clean}` : '/download', 303);
}
const rawKey = ((await keyFromCookie(Astro.cookies)) ?? '').toUpperCase();
const key = isLicenseKey(rawKey) ? rawKey : '';
const ua = Astro.request.headers.get('user-agent') ?? '';
const phone = /iPhone|iPad|iPod|Android/i.test(ua);
const guess = /Windows/i.test(ua) ? 'windows' : /Linux/i.test(ua) && !phone ? 'linux' : 'mac';
const asked = Astro.url.searchParams.get('platform') ?? '';
const selected = Object.hasOwn(PLATFORMS, asked) ? asked : guess;

const apps = [
  { id: 'mac', name: 'macOS', note: 'Apple silicon', icon: 'apple' },
  { id: 'windows', name: 'Windows', note: '64-bit installer', icon: 'monitor' },
  { id: 'linux', name: 'Linux', note: 'AppImage', icon: 'terminal' },
];
const more = [
  { id: 'mac-intel', label: 'macOS Intel' },
  { id: 'windows-msi', label: 'Windows MSI' },
  { id: 'linux-deb', label: '.deb' },
  { id: 'linux-rpm', label: '.rpm' },
];
const servers = Object.entries(PLATFORMS)
  .filter(([id]) => id.startsWith('server-'))
  .map(([id, p]) => ({ id, label: p.label.replace('Headless server · ', '') }));
const install = `curl -fsSL ${SITE.url}/install.sh | sh`;
const pageUrl = `${SITE.url}/download`;
const handoff = `mailto:?subject=${encodeURIComponent('Download Godmode')}&body=${encodeURIComponent(`Godmode for Mac, Windows and Linux, free for 7 days:\n${pageUrl}\n`)}`;
Astro.response.headers.set('cache-control', 'no-store');
Astro.response.headers.set('referrer-policy', 'same-origin');
---

<Base title="Download" description="Download Godmode for Mac, Windows and Linux. Free for 7 days, no card. Then add a licence key.">
  <Nav home={false} />
  <main class="pt-36 pb-24">
    <div class="container-x max-w-[720px]">
      <p class="eyebrow"><span class="n">●</span> Download</p>
      <h1 class="h-section mt-5">Download Godmode</h1>
      <p class="lead mt-5">Free for 7 days, no card. Then add a licence key.</p>

      {
        phone ? (
          <div class="card mt-10 p-6 sm:p-8">
            <div class="flex items-start gap-4">
              <span class="grid size-11 flex-none place-items-center rounded-xl bg-brand-soft text-brand">
                <Icon name="laptop" size={20} />
              </span>
              <div>
                <p class="h-card">Send it to your computer</p>
                <p class="mt-1.5 text-[14px] leading-relaxed text-muted">Godmode runs on a Mac, Windows or Linux computer. Open this page there to download.</p>
              </div>
            </div>
            <div class="mt-5 flex flex-col gap-2 sm:flex-row">
              <a href={handoff} class="btn btn-primary sm:flex-1" data-track="download_handoff_email">
                <Icon name="mail" size={16} /> Email me the link
              </a>
              <button type="button" class="btn btn-ghost sm:flex-1" data-copy={pageUrl} data-track="download_handoff_copy">
                <Icon name="link" size={15} /> <span data-copy-label>Copy link</span>
              </button>
            </div>
          </div>
        ) : (
          <a href={`/download/${selected}`} class="btn btn-primary btn-lg mt-10 w-full sm:w-auto" data-track={`download_${selected}`}>
            <Icon name="download" size={17} /> Download for {PLATFORMS[selected].label}
          </a>
        )
      }

      <div class="mt-4 grid gap-3 sm:grid-cols-3">
        {
          apps.map((a) => (
            <a
              href={`/download/${a.id}`}
              class:list={['card flex items-center gap-4 p-5', !phone && a.id === selected && 'ring-1 ring-[var(--brand-line)]']}
              data-track={`download_${a.id}`}
            >
              <Icon name={a.icon} size={22} />
              <span>
                <b class="block text-[15px] font-medium">{a.name}</b>
                <span class="text-[12.5px] text-muted">{a.note}</span>
              </span>
            </a>
          ))
        }
      </div>
      <p class="mt-3 text-center text-[12.5px] text-dim">
        Also:
        {
          more.map((m, i) => (
            <>
              {i > 0 && ' · '}
              <a class="underline decoration-line-2 underline-offset-2 hover:text-text" href={`/download/${m.id}`} data-track={`download_${m.id}`}>
                {m.label}
              </a>
            </>
          ))
        }
      </p>

      {
        key && (
          <div class="card mt-10 p-6 sm:p-8">
            <p class="font-mono text-[11px] tracking-[0.12em] text-dim uppercase">Your licence key</p>
            <div class="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center">
              <code class="flex-1 rounded-xl bg-[rgb(0_0_0/0.35)] px-4 py-3.5 font-mono text-[16px] tracking-[0.04em] break-all text-text ring-1 ring-line-2 sm:text-[18px] sm:tracking-[0.06em]">
                {key}
              </code>
              <button type="button" class="btn btn-ghost" data-copy={key}>
                <Icon name="copy" size={15} /> <span data-copy-label>Copy</span>
              </button>
            </div>
            <p class="mt-3 text-[13px] text-muted">Paste it into Godmode during setup, or later in Settings → License.</p>
          </div>
        )
      }

      <div class="mt-10 rounded-[22px] p-6 ring-1 ring-line sm:p-8">
        <div class="flex items-start gap-4">
          <span class="grid size-11 flex-none place-items-center rounded-xl bg-[rgb(255_250_240/0.05)] text-text-2">
            <Icon name="server" size={20} />
          </span>
          <div class="min-w-0 flex-1">
            <p class="h-card">Always-on server</p>
            <p class="mt-1.5 text-[14px] leading-relaxed text-muted">For a spare Mac or PC you reach from any browser. Same free week.</p>
          </div>
        </div>
        <div class="mt-5 flex flex-col gap-2 sm:flex-row sm:items-center">
          <code class="min-w-0 flex-1 overflow-x-auto rounded-xl bg-[rgb(0_0_0/0.35)] px-4 py-3 font-mono text-[13px] whitespace-nowrap text-text-2 ring-1 ring-line-2">{install}</code>
          <button type="button" class="btn btn-ghost btn-sm" data-copy={install} data-track="download_install_copy">
            <Icon name="copy" size={14} /> <span data-copy-label>Copy</span>
          </button>
        </div>
        <p class="mt-3 text-[12.5px] leading-relaxed text-dim">
          Or the binary:
          {
            servers.map((s, i) => (
              <>
                {i > 0 && ' · '}
                <a class="underline decoration-line-2 underline-offset-2 hover:text-text" href={`/download/${s.id}`} data-track={`download_${s.id}`}>
                  {s.label}
                </a>
              </>
            ))
          }
        </p>
      </div>

      <p class="mt-8 text-[14px] leading-relaxed text-muted">
        After the free week, add your licence key in the app or start the 14-day free trial.
        <a href="/#pricing" class="text-text underline decoration-line-3 underline-offset-2">See pricing</a>.
      </p>
    </div>
  </main>
  <Footer />
</Base>
