    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.3",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.0.14",
    "pg": "^8.23.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "recharts": "3.8.0",
