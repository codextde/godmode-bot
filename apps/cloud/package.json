{
  "name": "@godmode/cloud",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Godmode Cloud — accounts, billing, admin dashboard and the relay gateway that lets you reach your Godmode from any browser.",
  "scripts": {
    "dev": "tsx server/main.ts",
    "build": "next build && node scripts/build-server.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "NODE_ENV=production node dist/server.mjs",
    "typecheck": "next typegen && tsc --noEmit -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@godmode/shared": "workspace:*",
