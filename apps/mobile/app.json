{
  "expo": {
    "name": "Godmode",
    "slug": "godmode",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "godmode",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "de.codext.godmode",
      "buildNumber": "3",
      "icon": "./assets/godmode.icon",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Godmode connects to your computer over your private Tailscale network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "ts.net": {
              "NSIncludesSubdomains": true,
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "de.codext.godmode",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#1C1C1C",
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon.png"
      },
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "./plugins/with-scene-lifecycle",
      "expo-router",
      [
        "expo-font",
        {
          "ios": {
            "fonts": [
              "@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
              "@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
              "@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
              "@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf",
              "@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
              "@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf"
            ]
          },
          "android": {
            "fonts": [
              {
                "fontFamily": "Geist-Regular",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist/400Regular/Geist_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Geist-Medium",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist/500Medium/Geist_500Medium.ttf",
                    "weight": 500
                  }
                ]
              },
              {
                "fontFamily": "Geist-SemiBold",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist/600SemiBold/Geist_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Geist-Bold",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist/700Bold/Geist_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "GeistMono-Regular",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist-mono/400Regular/GeistMono_400Regular.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "GeistMono-Medium",
                "fontDefinitions": [
                  {
                    "path": "@expo-google-fonts/geist-mono/500Medium/GeistMono_500Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 88,
          "backgroundColor": "#FAF9F5",
          "dark": {
            "backgroundColor": "#1C1B19"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Godmode uses the camera to scan the pairing code on your computer and to take photos you send to your agents.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Godmode lets you pick photos and videos to send to your agents.",
          "cameraPermission": "Godmode uses the camera to scan the pairing code on your computer and to take photos you send to your agents.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Godmode with Face ID."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
