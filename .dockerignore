**/dist
**/dist-cloud
**/.next
**/.data
**/target
**/.DS_Store
**/*.log
**/.env
**/.env.*
.git
.github
.omc
.godmode
*.godmode-backup
packages/core/bin
apps/desktop/src-tauri
docs
idea.md
Dockerfile
docker-compose.yml
**/.dev.vars
**/.secrets.local
**/.wrangler
apps/mobile
